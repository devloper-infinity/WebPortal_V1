                            <li class="nav-item"><a href="Deals.aspx" class="nav-link">Deals</a></li>
                            <li class="nav-item"><a href="Activities.aspx" class="nav-link">Activities</a></li>
                            <li class="nav-item"><a href="Reports.aspx" class="nav-link">Reports</a></li>
                            <li class="nav-item"><a href="Settings.aspx" class="nav-link">Settings</a></li>
                        </ul>
                    </div>

                    <ul class="order-1 order-md-3 navbar-nav navbar-no-expand ml-auto">
