<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="CRM.Master.cs" Inherits="WebPortal.CRM.CRM" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Infinity IPS - CRM</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">
    <script src="../plugins/jquery/jquery.min.js"></script>
    <link rel="stylesheet" href="../plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="../plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="../plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="../plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
    <link rel="stylesheet" href="../dist/css/adminlte.min.css">
    <link rel="stylesheet" href="CRM.css?v=20260709-1">
    <script src="../Scripts/SessionHandler.js"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <script>
        $(document).ready(function () {
            $.ajax({
                type: "POST",
                url: "../MenuService.aspx/LoadMenu",
                contentType: "application/json",
                dataType: "json",
                success: function (res) {
                    var menuTree = res.d || [];
                    var html = "";
                    menuTree.forEach(function (m) { html += renderTopMenu(m); });
                    $("#dynamicMenu").html(html);
                }
            });
        });

        function renderTopMenu(menu) {
            var children = menu.Children || [];
            if (children.length === 0) {
                return '<li class="nav-item"><a href="' + (menu.Url || '#') + '" class="nav-link">' + menu.MenuName + '</a></li>';
            }

            var isMega = children.some(function (x) { return x.SectionName; });
            if (!isMega) {
                return '<li class="nav-item dropdown"><a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">' + menu.MenuName + '</a><ul class="dropdown-menu border-0 shadow">' + children.map(renderSimpleItem).join("") + '</ul></li>';
            }

            return '<li class="nav-item dropdown"><a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">' + menu.MenuName + '</a><ul class="dropdown-menu border-0 shadow crm-mega-menu"><div class="col-sm-12"><div class="row">' + renderMegaSections(children) + '</div></div></ul></li>';
        }

        function renderSimpleItem(item) {
            var children = item.Children || [];
            if (children.length === 0) {
                return '<li><a class="dropdown-item" href="' + (item.Url || '#') + '">' + item.MenuName + '</a></li>';
            }
            return "";
        }

        function renderMegaSections(children) {
            var html = "";
            children.forEach(function (section) {
                var items = section.Children || [];
                if (items.length > 0) {
                    html += '<div class="col-sm-4"><div class="callout callout-info crm-menu-section"><h6 class="m-0"><b>' + section.MenuName + '</b></h6></div>' + items.map(function (item) {
                        return '<a href="' + (item.Url || '#') + '" class="dropdown-item">' + item.MenuName + '</a>';
                    }).join("") + '</div>';
                }
            });
            return html;
        }
    </script>
</head>
<body class="hold-transition sidebar-collapse layout-top-nav crm-body">
    <form id="form1" runat="server">
        <asp:ToolkitScriptManager ID="ToolkitScriptManager1" runat="server" EnablePageMethods="true">
