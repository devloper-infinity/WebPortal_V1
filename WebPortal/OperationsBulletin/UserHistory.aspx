<%@ Page Title="My Bulletins" Language="C#" MasterPageFile="~/OperationsBulletin/OperationsBulletin.Master" AutoEventWireup="true" CodeBehind="UserHistory.aspx.cs" Inherits="WebPortal.OperationsBulletin.UserHistory" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><style>.ubh-shell{padding:8px 12px 30px}.ubh-header{padding:18px 22px;border-radius:10px;background:linear-gradient(100deg,#163d72,#147ad6);color:#fff;margin-bottom:16px}.ubh-header h1{font-size:22px;margin:0}.ubh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px}.ubh-card{display:flex;flex-direction:column;min-height:96px;padding:8px 10px;background:#fff;border:1px solid #dde6ee;border-left:4px solid #4e91d8;border-radius:8px}.ubh-card.important{border-left-color:#f59e0b}.ubh-card.critical{border-left-color:#dc3545}.ubh-meta{font-size:9px;line-height:1.2;color:#738294}.ubh-card h3{font-size:13px;line-height:1.2;margin:4px 0 6px}.ubh-flags{margin-top:auto}.ubh-actions{display:flex;gap:5px;margin-top:6px;padding-top:6px;border-top:1px solid #edf1f5}.ubh-icon{display:inline-flex;align-items:center;justify-content:center;width:29px;height:29px;padding:0;border-radius:50%}#ubhFrame{width:100%;height:55vh;border:1px solid #dce3ed}.ubh-summary{margin-bottom:16px;line-height:1.5}.ubh-empty{padding:40px;text-align:center;color:#6b7888}</style><script>document.addEventListener('click',function(e){if(e.target.closest('.ubh-card button,#ubhModal button'))e.preventDefault();});</script></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="ubh-shell"><header class="ubh-header"><h1><i class="fas fa-bullhorn"></i> My Bulletins</h1><div>Previously assigned operations bulletins</div></header><div class="form-row mb-3"><div class="col-md-2"><label>From Date</label><input id="ubhFrom" type="date" class="form-control"></div><div class="col-md-2"><label>To Date</label><input id="ubhTo" type="date" class="form-control"></div><div class="col-md-8"><label>Search</label><input id="ubhSearch" class="form-control" placeholder="Search subject or bulletin content (e.g. Quality, FEMA)"></div></div><div id="ubhCards" class="ubh-grid"></div></div><div id="ubhModal" class="modal fade"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><h5 id="ubhTitle" class="modal-title"></h5><div id="ubhBadges"></div></div><button class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><div id="ubhSummary" class="ubh-summary"></div><iframe id="ubhFrame" title="Bulletin document"></iframe></div></div></div></div><script src="UserHistory.js?v=3"></script><script>document.addEventListener("click",function(e){var b=e.target.closest("button[onclick^='UBH.view']");if(!b)return;var m=/UBH\.view\((\d+)\)/.exec(b.getAttribute("onclick")||"");if(!m)return;var x=new XMLHttpRequest();x.open("POST","UserHistory.aspx/TrackView",true);x.setRequestHeader("Content-Type","application/json; charset=utf-8");x.send(JSON.stringify({bulletinId:+m[1],documentVersionId:null}));});</script></asp:Content>
