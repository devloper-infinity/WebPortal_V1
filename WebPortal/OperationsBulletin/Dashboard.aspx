<%@ Page Title="Operations Bulletin & Document Center" Language="C#" MasterPageFile="~/OperationsBulletin/OperationsBulletin.Master" AutoEventWireup="true" CodeBehind="Dashboard.aspx.cs" Inherits="WebPortal.OperationsBulletin.Dashboard" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><link href="Bulletin.css?v=2" rel="stylesheet" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div id="obLoading"><div class="spinner-border text-primary"></div><span>Working...</span></div>
<div class="ob-shell">
 <header class="ob-header"><div><h1><i class="fas fa-bullhorn"></i> Operations Bulletin & Document Center</h1><p>Updates, controlled documents and acknowledgements</p></div><a href="Manage.aspx" class="btn btn-light manager-only"><i class="fas fa-plus"></i> New Bulletin</a></header>
 <nav class="ob-nav nav nav-pills"><a class="nav-link active" data-toggle="pill" href="#obBulletins">Bulletins <span id="obUnreadBadge" class="badge badge-danger"></span></a><a class="nav-link" data-toggle="pill" href="#obDocuments">Documents</a><a class="nav-link manager-only" data-toggle="pill" href="#obReports">Reports</a><a class="nav-link admin-only" data-toggle="pill" href="#obPermissions">Permissions</a></nav>
 <div class="tab-content">
  <section id="obBulletins" class="tab-pane fade show active">
   <div class="ob-stats"><div><b id="sToday">0</b><span>Today</span></div><div><b id="sUnread">0</b><span>Unread</span></div><div><b id="sImportant">0</b><span>Important</span></div><div><b id="sArchived">0</b><span>Archived</span></div></div>
   <div class="ob-filter"><input id="fFrom" type="date" class="form-control"><input id="fTo" type="date" class="form-control"><select id="fDomain" class="form-control"></select><select id="fLocation" class="form-control"></select><select id="fProject" class="form-control"></select><select id="fCategory" class="form-control"><option value="">All Categories</option><option>Operations</option><option>Policy</option><option>Client Update</option><option>Training</option></select><select id="fStatus" class="form-control"><option value="">All Statuses</option><option>Unread</option><option>Viewed</option><option>Read</option><option>Acknowledged</option><option value="Important">Important / Critical</option><option>Archived</option></select><button id="obApply" class="btn btn-primary">Apply</button></div>
   <div id="obBulletinCards" class="ob-card-grid"></div>
  </section>
  <section id="obDocuments" class="tab-pane fade">
   <div class="ob-explorer">
    <aside><div class="ob-side-title">Folders <button id="obAddRoot" class="btn btn-sm btn-link folder-create"><i class="fas fa-plus"></i></button></div><div id="obFolderTree"></div></aside>
    <main><div class="ob-toolbar"><div id="obBreadcrumb"></div><div><button id="obAddFolder" class="btn btn-sm btn-outline-primary folder-create"><i class="fas fa-folder-plus"></i> New Subfolder</button> <button id="obUpload" class="btn btn-sm btn-primary folder-upload">Upload</button></div></div><div class="ob-doc-filter"><input id="obDocSearch" class="form-control" placeholder="Search this folder"><input id="obDocFrom" type="date" class="form-control"><input id="obDocTo" type="date" class="form-control"><select id="obDocSort" class="form-control"><option value="name">Name</option><option value="date">Date</option></select></div><div id="obFolderGrid" class="ob-file-grid"></div></main>
   </div>
  </section>
  <section id="obReports" class="tab-pane fade"><div class="ob-panel"><div class="ob-filter"><input id="rFrom" type="date" class="form-control"><input id="rTo" type="date" class="form-control"><select id="rDomain" class="form-control"></select><select id="rLocation" class="form-control"></select><select id="rProject" class="form-control"></select><select id="rEmployee" class="form-control"></select><button id="obRunReport" class="btn btn-primary">Run</button></div><table id="obReportTable" class="table table-striped table-bordered w-100"></table></div></section>
  <section id="obPermissions" class="tab-pane fade"><div class="ob-panel"><h5>Employee Folder Rights</h5><div class="row"><div class="col-md-4"><select id="pFolder" class="form-control"></select></div><div class="col-md-4"><select id="pEmployee" class="form-control"></select></div></div><div class="ob-rights"><label><input type="checkbox" data-right="canView"> View</label><label><input type="checkbox" data-right="canUpload"> Upload</label><label><input type="checkbox" data-right="canCreateFolder"> Create Folder</label><label><input type="checkbox" data-right="canRenameFolder"> Rename</label><label><input type="checkbox" data-right="canMoveFolder"> Move</label><label><input type="checkbox" data-right="canDeleteFolder"> Delete</label><label><input type="checkbox" data-right="canManagePermissions"> Manage Rights</label><label><input id="pInherit" type="checkbox" checked> Inherit to children</label></div><button id="obSaveRights" class="btn btn-primary">Save Rights</button></div></section>
 </div>
</div>

<div id="obBulletinModal" class="modal fade"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Bulletin</h5><button class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input id="bId" type="hidden"><div class="form-row"><div class="form-group col-md-8"><label>Title</label><input id="bTitle" class="form-control" maxlength="250"></div><div class="form-group col-md-4"><label>Category</label><input id="bCategory" class="form-control" maxlength="80"></div></div><div class="form-row"><div class="form-group col-md-4"><label>Priority</label><select id="bPriority" class="form-control"><option>Normal</option><option>Important</option><option>Critical</option></select></div><div class="form-group col-md-4"><label>Schedule</label><input id="bSchedule" type="datetime-local" class="form-control"></div><div class="form-group col-md-4"><label>Folder</label><select id="bFolder" class="form-control"></select></div></div><div class="form-group"><label>Summary</label><textarea id="bSummary" class="form-control" rows="4" maxlength="2000"></textarea></div><div class="form-group"><label>Word/PDF Attachment</label><input id="bFile" type="file" accept=".docx,.pdf" class="form-control-file"></div><div class="form-group"><label>Audience</label><select id="bAudienceType" class="form-control"><option value="AllOperations">All Loan Processing &amp; Production employees</option><option value="Domain">Domain</option><option value="Location">Location</option><option value="Project">Project</option><option value="Employee">Selected employees</option></select><select id="bAudienceValues" class="form-control mt-2" multiple></select></div><label><input id="bAck" type="checkbox"> Acknowledgement required</label></div><div class="modal-footer"><button id="obSaveDraft" class="btn btn-secondary">Save Draft</button><button id="obPublish" class="btn btn-primary">Publish / Schedule</button></div></div></div></div>
<div id="obFolderModal" class="modal fade"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>Folder</h5><button class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input id="folderName" class="form-control" maxlength="150" placeholder="Folder name"></div><div class="modal-footer"><button id="obSaveFolder" class="btn btn-primary">Save</button></div></div></div></div>
<div id="obUploadModal" class="modal fade"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>Upload Document</h5><button class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input id="obFile" type="file" accept=".docx,.pdf" class="form-control-file"><input id="obVersionDocument" type="hidden"></div><div class="modal-footer"><button id="obSendFile" class="btn btn-primary">Upload</button></div></div></div></div>
<div id="obViewModal" class="modal fade"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><h5 id="obViewTitle" class="modal-title"></h5><div id="obViewBadges" class="mt-1"></div></div><div><button type="button" class="btn btn-sm btn-primary mr-2" onclick="OB.screenshot()"><i class="fas fa-camera"></i> Take Screenshot</button><button type="button" class="close" data-dismiss="modal">&times;</button></div></div><div class="modal-body"><div id="obViewSummary" class="bulletin-html"></div><iframe id="obViewFrame" title="Bulletin document"></iframe></div></div></div></div>
<div id="obPreviewModal" class="modal fade"><div class="modal-dialog modal-xl"><div class="modal-content"><div class="modal-header"><h5>Document Preview</h5><button class="close" data-dismiss="modal">&times;</button></div><div class="modal-body p-0"><iframe id="obPreviewFrame" title="Document preview"></iframe></div></div></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="Bulletin.js?v=10"></script>
</asp:Content>
