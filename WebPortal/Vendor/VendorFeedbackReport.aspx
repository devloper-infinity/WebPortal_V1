<%@ Page Title="" Language="C#" MasterPageFile="~/Vendor/VendorMaster.Master" AutoEventWireup="true" CodeBehind="VendorFeedbackReport.aspx.cs" Inherits="WebPortal.Vendor.VendorFeedbackReport" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
    <style>
.erp-page{padding:16px 20px 24px;background:#f4f7fb;min-height:calc(100vh - 110px)}
.erp-hero{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;margin-bottom:14px;border-radius:7px;background:linear-gradient(135deg,#123f70,#276da8);color:#fff}.erp-hero h2{margin:0;font-size:21px;font-weight:600}.erp-hero .crumb{margin-top:4px;font-size:12px;opacity:.9}
.erp-tabs{display:flex;gap:4px;border-bottom:1px solid #dce5ef;margin-bottom:14px}.erp-tab{border:0;background:transparent;padding:12px 18px;font-weight:600;color:#475569;cursor:pointer;border-bottom:3px solid transparent}.erp-tab.active{color:#15588d;border-bottom-color:#276da8}.tab-pane{display:none}.tab-pane.active{display:block}
.erp-panel{background:#fff;border:1px solid #dce5ef;border-radius:7px;margin-bottom:14px;overflow:hidden}.erp-panel-head{display:flex;align-items:center;justify-content:space-between;padding:13px 18px;border-bottom:1px solid #e2e8f0;background:#f8fafc}.erp-panel-head h3{margin:0;font-size:17px;color:#14263d}.erp-panel-body{padding:14px 18px}
.form-grid{display:grid;grid-template-columns:minmax(220px,1.4fr) minmax(180px,1fr) minmax(180px,1fr) auto;gap:14px;align-items:end}.field label{display:block;margin-bottom:5px;color:#334155;font-size:13px;font-weight:600}.erp-control{width:100%;height:38px;border:1px solid #cbd7e3;border-radius:5px;padding:7px 10px;background:#fff;box-sizing:border-box}.btn-row{display:flex;gap:8px}.erp-btn{border:0;border-radius:5px;padding:10px 17px;font-size:13px;font-weight:600;cursor:pointer}.erp-btn-primary{background:#1f6fae;color:#fff}.erp-btn-light{background:#e7edf4;color:#21364d}.erp-btn-success{background:#198754;color:#fff}.erp-btn:disabled{opacity:.55;cursor:not-allowed}
.message{display:none;margin-bottom:12px;padding:10px 12px;border-radius:5px;font-size:13px}.message.success{display:block;background:#dff3e7;color:#185c37}.message.error{display:block;background:#fde5e7;color:#8b1e2b}
.grid-wrap{position:relative;overflow:hidden}.grid-loader{position:absolute;inset:0;z-index:20;display:none;align-items:center;justify-content:center;background:rgba(255,255,255,.78);font-weight:600;color:#1f5e91}
table.dataTable{width:100%!important;border-collapse:collapse!important}table.dataTable thead th{white-space:nowrap;background:#e8f1f8;color:#163d61;border:1px solid #cad8e5!important;font-size:12px;font-weight:700;padding:10px 9px!important}table.dataTable tbody td{white-space:nowrap;border:1px solid #e0e7ef!important;color:#334155;font-size:12px;padding:8px 9px!important}table.dataTable tbody tr:nth-child(even){background:#f8fafc}table.dataTable tbody tr:hover{background:#eef6fc}.dataTables_wrapper .dataTables_filter{margin-bottom:10px}.dataTables_wrapper .dataTables_filter input{border:1px solid #cbd7e3;border-radius:5px;padding:7px 9px;outline:none}
.icon-btn{border:0;background:transparent;color:#1f6fae;cursor:pointer;padding:4px 7px}.icon-btn svg{width:17px;height:17px;vertical-align:middle}.edit-input{min-width:110px;height:30px;border:1px solid #b9c8d8;border-radius:4px;padding:4px 6px}.import-summary{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:12px}.summary-pill{padding:7px 12px;border-radius:16px;font-size:12px;font-weight:700;background:#edf3f8;color:#23435f}.summary-pill.good{background:#dff3e7;color:#185c37}.summary-pill.bad{background:#fde5e7;color:#8b1e2b}
@media(max-width:1000px){.form-grid{grid-template-columns:1fr 1fr}.btn-row{grid-column:1/-1}}@media(max-width:650px){.form-grid{grid-template-columns:1fr}}
</style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
    <div class="erp-page">
  <div class="erp-hero"><div><h2>Vendor Feedback</h2><div class="crumb">Vendor Billing / Vendor Feedback</div></div></div>
  <div id="message" class="message"></div>
  <div class="erp-tabs"><button type="button" class="erp-tab active" data-tab="detailsTab">Vendor Feedback</button><button type="button" class="erp-tab" data-tab="importTab">Import Vendor Feedback</button></div>

  <div id="detailsTab" class="tab-pane active">
    <div class="erp-panel"><div class="erp-panel-head"><h3>Vendor Feedback Details</h3></div><div class="erp-panel-body">
      <div class="form-grid">
        <div class="field"><label>Project</label><select id="ddlProjects" class="erp-control"><option value="">Select</option></select></div>
        <div class="field"><label>From Date</label><input id="txtFrom" type="date" class="erp-control" /></div>
        <div class="field"><label>To Date</label><input id="txtTo" type="date" class="erp-control" /></div>
        <div class="btn-row"><button type="button" id="btnShow" class="erp-btn erp-btn-primary">Show</button><button type="button" id="btnClear" class="erp-btn erp-btn-light">Clear</button><button type="button" id="btnExport" class="erp-btn erp-btn-success">Export to Excel</button></div>
      </div>
    </div></div>
    <div class="erp-panel"><div class="erp-panel-head"><h3>Vendor Details | Total Count: <span id="detailsCount">0</span></h3></div><div class="erp-panel-body grid-wrap"><div id="detailsLoader" class="grid-loader">Loading...</div>
      <table id="detailsTable" class="display nowrap" style="width:100%"><thead><tr><th>Action</th><th>Sr. #</th><th>Compare ID</th><th>Project #</th><th>Job Type</th><th>Order Date</th><th>File Name</th><th>Records</th><th>Vendor Code</th><th>Accuracy</th><th>Total Chars</th><th>Chars After Penalty</th><th>ISP</th><th>MRW</th><th>MRL</th><th>MRP</th><th>MRT</th><th>Image No.</th><th>Field Name</th><th>Error</th><th>Should Be</th><th>Mistake</th><th>Status</th></tr></thead><tbody></tbody></table>
    </div></div>
  </div>

  <div id="importTab" class="tab-pane">
    <div class="erp-panel"><div class="erp-panel-head"><h3>Import Vendor Feedback</h3><a href="../VendorFeedback.xls" class="erp-btn erp-btn-light" style="text-decoration:none">Download Format</a></div><div class="erp-panel-body">
      <div class="form-grid" style="grid-template-columns:minmax(240px,1fr) minmax(280px,2fr) auto">
        <div class="field"><label>Project</label><select id="ddlImportProject" class="erp-control"><option value="">Select</option></select></div>
        <div class="field"><label>Excel File</label><input id="importFile" type="file" class="erp-control" accept=".xls,.xlsx" /></div>
        <div class="btn-row"><button type="button" id="btnImport" class="erp-btn erp-btn-primary">Import Excel</button></div>
      </div>
    </div></div>
    <div class="erp-panel"><div class="erp-panel-head"><h3>Import Result</h3></div><div class="erp-panel-body grid-wrap"><div id="importLoader" class="grid-loader">Importing...</div>
      <div class="import-summary"><span id="importTotal" class="summary-pill">Total: 0</span><span id="importAdded" class="summary-pill good">Added: 0</span><span id="importRejected" class="summary-pill bad">Not Added: 0</span></div>
      <table id="importTable" class="display nowrap" style="width:100%"><thead><tr></tr></thead><tbody></tbody></table>
    </div></div>
  </div>
</div>
<script src="../bootstrap/js/jquery.dataTables.min.js"></script>
<script>
(function(){
 var pageUrl='<%= ResolveUrl("VendorBillingDetails.aspx") %>', detailsTable, importTable, detailRows=[];
 var detailColumns=['CompareID','ProjectNumber','JobType','OrderDate','FileName','Records','VendorCode','Accuracy','TotalChars','CharsAfterPenalty','ISP','MRW','MRL','MRP','MRT','ImageNo','FieldName','Error','ShouldBe','Mistake','Status'];
 $(function(){
  detailsTable=$('#detailsTable').DataTable({paging:false,searching:true,ordering:true,info:false,scrollX:true,scrollY:'58vh',scrollCollapse:true,autoWidth:false,order:[]});
  importTable=$('#importTable').DataTable({paging:false,searching:true,ordering:true,info:false,scrollX:true,scrollY:'52vh',scrollCollapse:true,autoWidth:false,order:[]});
  loadProjects();
  $('.erp-tab').on('click',function(){var id=$(this).data('tab');$('.erp-tab').removeClass('active');$(this).addClass('active');$('.tab-pane').removeClass('active');$('#'+id).addClass('active');setTimeout(function(){$.fn.dataTable.tables({visible:true,api:true}).columns.adjust();},50);});
  $('#btnShow').on('click',loadDetails); $('#btnClear').on('click',function(){$('#ddlProjects').val('');$('#txtFrom,#txtTo').val('');bindDetails([]);});
  $('#btnExport').on('click',function(){exportCsv('#detailsTable','VendorDetails.csv');}); $('#btnImport').on('click',importExcel);
  $('#detailsTable').on('click','.js-edit',startEdit).on('click','.js-save',saveEdit).on('click','.js-cancel',function(){bindDetails(detailRows);});
 });
 function loadProjects(){call('GetProjects',{}).done(function(r){var x=unwrap(r);if(!x.Success){showMessage(x.Message,false);return;}var rows=x.Data||[],html='<option value="">Select</option>';$.each(rows,function(_,p){var text=valAny(p,['ProjectName','ProjectNumber','Project']),value=valAny(p,['ProjectName','ProjectNumber','ProjectId']);html+='<option value="'+esc(value)+'">'+esc(text)+'</option>';});$('#ddlProjects,#ddlImportProject').html(html);}).fail(ajaxFail);}
 function loadDetails(){var project=$('#ddlProjects option:selected').text();if(!$('#ddlProjects').val()){showMessage('Please select project.',false);return;}showLoader('#detailsLoader',true);call('GetVendorDetails',{projectNumber:project,fromDate:toServerDate($('#txtFrom').val()),toDate:toServerDate($('#txtTo').val())}).done(function(r){var x=unwrap(r);if(!x.Success){showMessage(x.Message,false);return;}bindDetails(x.Data||[]);}).fail(ajaxFail).always(function(){showLoader('#detailsLoader',false);});}
 function bindDetails(rows){detailRows=rows||[];detailsTable.clear();$.each(detailRows,function(i,row){var action=iconButton('js-edit','Edit',editSvg()),cells=[action,i+1];$.each(detailColumns,function(_,c){var v=val(row,c);if(c==='OrderDate')v=formatDate(v);cells.push(esc(v));});detailsTable.row.add(cells);});detailsTable.draw(false);$('#detailsCount').text(detailRows.length);}
 function startEdit(){var tr=$(this).closest('tr'),idx=detailsTable.row(tr).index(),row=detailRows[idx],cells=[iconButton('js-save','Save',saveSvg())+iconButton('js-cancel','Cancel',cancelSvg()),idx+1];$.each(detailColumns,function(_,c){var v=val(row,c);if(['OrderDate','FileName','Records','Accuracy','TotalChars','CharsAfterPenalty'].indexOf(c)>=0)cells.push('<input class="edit-input" data-field="'+c+'" value="'+esc(c==='OrderDate'?formatInputDate(v):v)+'" type="'+(c==='OrderDate'?'date':'text')+'" />');else cells.push(esc(c==='OrderDate'?formatDate(v):v));});detailsTable.row(tr).data(cells).draw(false);tr.data('row-index',idx);}
 function saveEdit(){var tr=$(this).closest('tr'),idx=tr.data('row-index');if(idx==null)idx=detailsTable.row(tr).index();var row=detailRows[idx],payload={compareId:parseInt(val(row,'CompareID')||0,10),projectNumber:val(row,'ProjectNumber'),vendorCode:val(row,'VendorCode'),orderDate:'',fileName:'',records:0,totalChars:0,charsAfterPenalty:0,accuracy:0};tr.find('.edit-input').each(function(){var f=$(this).data('field'),v=$(this).val();if(f==='OrderDate')payload.orderDate=toServerDate(v);else if(f==='FileName')payload.fileName=v;else if(f==='Records')payload.records=parseInt(v||0,10);else if(f==='TotalChars')payload.totalChars=parseInt(v||0,10);else if(f==='CharsAfterPenalty')payload.charsAfterPenalty=parseInt(v||0,10);else if(f==='Accuracy')payload.accuracy=parseFloat(v||0);});call('UpdateVendorDetail',payload).done(function(r){var x=unwrap(r);showMessage(x.Message,x.Success);if(x.Success)loadDetails();}).fail(ajaxFail);}
 function importExcel(){var project=$('#ddlImportProject option:selected').text(),file=$('#importFile')[0].files[0];if(!$('#ddlImportProject').val()){showMessage('Please select project.',false);return;}if(!file){showMessage('Please select Excel file.',false);return;}var fd=new FormData();fd.append('file',file);fd.append('projectNumber',project);showLoader('#importLoader',true);$.ajax({url:pageUrl+'?action=import',type:'POST',data:fd,processData:false,contentType:false,dataType:'json'}).done(function(x){if(!x.Success){showMessage(x.Message,false);return;}bindImport(x.Data);showMessage(x.Message,true);}).fail(ajaxFail).always(function(){showLoader('#importLoader',false);});}
 function bindImport(data){data=data||{};var rows=data.AddedRows||[],cols=[];$.each(rows,function(_,r){$.each(r,function(k){if(cols.indexOf(k)<0)cols.push(k);});});if($.fn.DataTable.isDataTable('#importTable'))importTable.destroy();var head=$('#importTable thead tr').empty();$.each(cols,function(_,c){head.append($('<th/>').text(c));});var body=$('#importTable tbody').empty();$.each(rows,function(_,r){var tr=$('<tr/>');$.each(cols,function(_,c){tr.append($('<td/>').text(r[c]==null?'':r[c]));});body.append(tr);});importTable=$('#importTable').DataTable({paging:false,searching:true,ordering:true,info:false,scrollX:true,scrollY:'52vh',scrollCollapse:true,autoWidth:false,order:[]});$('#importTotal').text('Total: '+(data.TotalCount||0));$('#importAdded').text('Added: '+(data.AddedCount||0));$('#importRejected').text('Not Added: '+(data.RejectedCount||0));}
 function call(m,d){return $.ajax({type:'POST',url:pageUrl+'/'+m,data:JSON.stringify(d),contentType:'application/json; charset=utf-8',dataType:'json'});}function unwrap(r){return r.d||r;}function val(o,k){return o&&o[k]!=null?o[k]:'';}function valAny(o,ks){for(var i=0;i<ks.length;i++)if(o&&o[ks[i]]!=null)return o[ks[i]];return'';}function esc(v){return $('<div/>').text(v==null?'':v).html();}
 function formatDate(v){if(!v)return'';var m=/\/Date\((-?\d+)/.exec(v);var d=m?new Date(parseInt(m[1],10)):new Date(v);if(isNaN(d.getTime()))return v;var mon=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return('0'+d.getDate()).slice(-2)+'-'+mon[d.getMonth()]+'-'+d.getFullYear();}function formatInputDate(v){if(!v)return'';var m=/\/Date\((-?\d+)/.exec(v),d=m?new Date(parseInt(m[1],10)):new Date(v);if(isNaN(d.getTime()))return'';return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);}function toServerDate(v){if(!v)return'';var p=v.split('-');return p.length===3?p[2]+'-'+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][parseInt(p[1],10)-1]+'-'+p[0]:v;}
 function iconButton(cls,title,svg){return'<button type="button" class="icon-btn '+cls+'" title="'+title+'">'+svg+'</button>';}function editSvg(){return'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>';}function saveSvg(){return'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>';}function cancelSvg(){return'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>';}
 function exportCsv(sel,name){var csv=[];$(sel+' tr').each(function(){var row=[];$(this).find('th,td').each(function(i){if(i>0)row.push('"'+$(this).text().replace(/"/g,'""')+'"');});csv.push(row.join(','));});var b=new Blob([csv.join('\r\n')],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name;a.click();URL.revokeObjectURL(a.href);}function showLoader(s,v){$(s).css('display',v?'flex':'none');}function showMessage(m,ok){$('#message').removeClass('success error').addClass(ok?'success':'error').text(m||'').show();setTimeout(function(){$('#message').fadeOut();},5000);}function ajaxFail(xhr){var msg=xhr.responseJSON&&xhr.responseJSON.Message?xhr.responseJSON.Message:xhr.statusText;showMessage('Request failed: '+msg,false);}
})();
</script>
</asp:Content>
