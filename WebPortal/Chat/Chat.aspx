<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Chat.aspx.cs" Inherits="WebPortal.Chat.ChatPage" %>
<!DOCTYPE html><html><head runat="server"><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Infinity Chat</title>
<link rel="stylesheet" href="../plugins/fontawesome-free/css/all.min.css"/><link rel="stylesheet" href="Chat.css"/><link rel="stylesheet" href="ChatGroup.css"/></head>
<body class="chat-page"><form id="form1" runat="server"><main class="chat-shell chat-full" aria-label="Infinity Chat">
 <aside class="chat-sidebar"><header><a class="chat-back" href="../Admin/DashboardEmployee.aspx" aria-label="Back to ERP"><i class="fas fa-arrow-left"></i></a><h1>Infinity Chat</h1><button id="chatNewGroup" type="button" title="New group"><i class="fas fa-users"></i></button></header><input id="chatSearch" class="chat-search" placeholder="Search people or messages"/><div id="chatConversations" class="chat-list"></div><h2>Employees</h2><div id="chatEmployees" class="chat-list employees"></div></aside>
 <section class="chat-main"><header id="chatHeader"><div><strong id="chatTitle">Select a conversation</strong><small id="chatStatus"></small></div></header><div id="chatMessages" class="chat-messages"></div><div id="chatTyping" class="chat-typing"></div><footer class="chat-compose"><label class="chat-attach" title="Attach file"><i class="fas fa-paperclip"></i><input id="chatFile" type="file" accept=".pdf,.xls,.xlsx,.doc,.docx,.png,.jpg,.jpeg,.gif,.txt"/></label><textarea id="chatText" maxlength="4000" rows="1" placeholder="Type a message"></textarea><button id="chatSend" type="button"><i class="fas fa-paper-plane"></i></button></footer></section>
</main></form><script src="../plugins/jquery/jquery.min.js"></script><script src="../Scripts/jquery.signalR-2.4.3.min.js"></script><script src="../signalr/hubs"></script><script src="Chat.js"></script><script>InfinityChat.mount({full:true});</script></body></html>
