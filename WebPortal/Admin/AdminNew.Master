<!-- ================= SCRIPTS ================= -->

<script>
   // $(document).ready(function() 
  jQuery(document).ready(function($)  {

      //  getPendingTaskNotifications_Sidebar();

        $.ajax({
            type: "POST",
            url: "../MenuService.aspx/LoadMenu",
            contentType: "application/json",
            dataType: "json",
            success: function(res) {
                let menuTree = res.d;
                let html = "";
                menuTree.forEach(m => html += renderTopMenu_1(m));
                $("#dynamicMenu").html(html);
            }
        });
    });

function renderTopMenu_1(menu) {

    let hasChildren = menu.Children.length > 0;

    if (!hasChildren) {
        return `
            <li class="nav-item">
                <a href="${menu.Url || '#'}" class="nav-link">
                    <i class="nav-icon fas fa-circle"></i>
                    <p>${menu.MenuName}</p>
                </a>
            </li>`;
    }

    return `
        <li class="nav-item has-treeview">
            <a href="#" class="nav-link">
                <i class="nav-icon fas fa-folder"></i>
                <p>
                    ${menu.MenuName}
                    <i class="right fas fa-angle-left"></i>
                </p>
            </a>
            <ul class="nav nav-treeview">
                ${menu.Children.map(renderChildMenu).join("")}
            </ul>
        </li>`;
}

function renderChildMenu(item) {
    return `
        <li class="nav-item">
            <a href="${item.Url || '#'}" class="nav-link">
                <i class="far fa-circle nav-icon"></i>
                <p>${item.MenuName}</p>
            </a>
        </li>`;
}
</script>

<script src="../plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="../dist/js/adminlte.min.js"></script>

