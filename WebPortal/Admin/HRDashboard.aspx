<%@ Page Title="HR Dashboard" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="HRDashboard.aspx.cs" Inherits="WebPortal.Admin.HRDashboard" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
<style>
.hrd{padding:18px}.hrd-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.hrd-head h1{font-size:24px;margin:0;color:#172033}.hrd-head p{margin:4px 0 0;color:#6b7890;font-size:13px}.hrd-filter{border:1px solid #dce3ee;border-radius:8px;padding:8px 12px;background:#fff}.hrd-kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:12px}.hrd-card{background:#fff;border:1px solid #e2e8f1;border-radius:11px;padding:15px}.hrd-kpi span{font-size:11px;color:#66758a}.hrd-kpi strong{display:block;font-size:25px;color:#172033;margin:7px 0 2px}.hrd-kpi small{color:#25825c}.hrd-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:12px;margin-bottom:12px}.hrd-bottom{display:grid;grid-template-columns:.72fr 1.28fr;gap:12px}.hrd-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.hrd-title h2{font-size:15px;margin:0}.hrd-title a{font-size:11px;color:#2878c7}.hrd-row{display:grid;grid-template-columns:1fr auto;gap:5px 10px;margin:10px 0;font-size:12px}.hrd-track{grid-column:1/-1;height:7px;border-radius:8px;background:#e8edf4;overflow:hidden}.hrd-track i{display:block;height:100%;background:#3e84c5;border-radius:8px}.hrd-req{display:grid;grid-template-columns:1fr auto;gap:4px 10px;padding:8px 0;border-top:1px solid #edf0f5}.hrd-req:first-child{border-top:0}.hrd-req b{font-size:12px}.hrd-req small{display:block;color:#68758a}.hrd table{width:100%;font-size:11px}.hrd th{color:#748197;font-weight:600;border:0!important}.hrd td{border-top:1px solid #edf0f5!important;vertical-align:middle}.hrd-badge{display:inline-block;padding:4px 8px;border-radius:20px;background:#fff3df;color:#b56b12}.hrd-badge.blue{background:#e9f2fc;color:#2f79b9}.hrd-badge.green{background:#e9f6ef;color:#25825c}.hrd-badge.red{background:#fdebed;color:#ca4652}@media(max-width:1000px){.hrd-kpis{grid-template-columns:repeat(3,1fr)}.hrd-grid,.hrd-bottom{grid-template-columns:1fr}}@media(max-width:600px){.hrd{padding:10px}.hrd-kpis{grid-template-columns:repeat(2,1fr)}.hrd-head{display:block}.hrd-filter{margin-top:10px}}
</style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="hrd">
 <div class="hrd-head"><div><h1>HR Operations Dashboard</h1><p>Latest recruitment, leave, absconding and exit updates</p></div><select class="hrd-filter"><option>All locations</option></select></div>
 <div class="hrd-kpis">
  <div class="hrd-card hrd-kpi"><span>Open positions</span><strong id="kOpen">-</strong><small>Live requisitions</small></div><div class="hrd-card hrd-kpi"><span>Applicants</span><strong id="kApplicants">-</strong><small>Accessible records</small></div><div class="hrd-card hrd-kpi"><span>New joinees</span><strong id="kJoinees">-</strong><small>Current month</small></div><div class="hrd-card hrd-kpi"><span>Leave records</span><strong id="kLeaves">-</strong><small>Current month</small></div><div class="hrd-card hrd-kpi"><span>Absconding</span><strong id="kAbsconding">-</strong><small>Current month</small></div><div class="hrd-card hrd-kpi"><span>Exits pending</span><strong id="kExits">-</strong><small>Step 2 + Step 3</small></div>
 </div>
 <div class="hrd-grid">
  <section class="hrd-card"><div class="hrd-title"><h2>Open Requisitions</h2><a href="Requisition.aspx">View all &gt;</a></div><div id="requisitionRows">Loading...</div></section>
  <section class="hrd-card"><div class="hrd-title"><h2>Exit Workflow</h2><a href="Resignation.aspx">Open workflow &gt;</a></div><div class="hrd-row"><span>Step 2 - Approval pending</span><b id="exitStep2">-</b><div class="hrd-track"><i id="exitStep2Bar"></i></div></div><div class="hrd-row"><span>Step 3 - Closure pending</span><b id="exitStep3">-</b><div class="hrd-track"><i id="exitStep3Bar"></i></div></div></section>
 </div>
 <div class="hrd-bottom">
  <section class="hrd-card"><div class="hrd-title"><h2>Recruitment Details</h2><a href="ViewAllApplicantList.aspx">View all &gt;</a></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Candidate</th><th>Position</th><th>Status</th></tr></thead><tbody id="applicantRows"><tr><td colspan="3">Loading...</td></tr></tbody></table></div></section>
  <section class="hrd-card"><div class="hrd-title"><h2>Latest HR Updates</h2></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Area</th><th>Current period</th><th>Action</th></tr></thead><tbody id="updateRows"><tr><td colspan="3">Loading...</td></tr></tbody></table></div></section>
 </div>
</div>
<script>
window.addEventListener('load', function(){
 function esc(v){return $('<div>').text(v==null?'':v).html();}
 function val(o,n){for(var i=0;i<n.length;i++)if(o[n[i]]!==undefined&&o[n[i]]!==null)return o[n[i]];return '-';}
 $.ajax({type:'POST',url:'HRDashboard.aspx/GetDashboardData',contentType:'application/json; charset=utf-8',data:'{}',dataType:'json'}).done(function(r){
  var d=r.d; $('#kOpen').text(d.OpenPositions);$('#kApplicants').text(d.Applicants);$('#kJoinees').text(d.Joinees);$('#kLeaves').text(d.Leaves);$('#kAbsconding').text(d.Absconding);$('#kExits').text(d.Step2+d.Step3);$('#exitStep2').text(d.Step2);$('#exitStep3').text(d.Step3);
  var max=Math.max(d.Step2,d.Step3,1);$('#exitStep2Bar').css('width',(d.Step2/max*100)+'%');$('#exitStep3Bar').css('width',(d.Step3/max*100)+'%');
  $('#requisitionRows').html(d.Requisitions.length?d.Requisitions.map(function(x){return '<div class="hrd-req"><span><b>'+esc(val(x,['ProfileName','PositionName','Position','RequisitionProfile']))+'</b><small>'+esc(val(x,['DomainName','Domain','Department']))+' - '+esc(val(x,['Location','BranchName','Branch']))+'</small></span><strong>'+esc(val(x,['NoOfPositions','NumberOfPositions','Positions','RequiredCount']))+'</strong></div>';}).join(''):'No open requisitions.');
  $('#applicantRows').html(d.Recruitment.length?d.Recruitment.map(function(x){return '<tr><td>'+esc(val(x,['FullName','ApplicantName','Name']))+'</td><td>'+esc(val(x,['PositionAppliedName','PositionApplied','ProfileName']))+'</td><td><span class="hrd-badge blue">'+esc(val(x,['Status','InterviewStatus']))+'</span></td></tr>';}).join(''):'<tr><td colspan="3">No applicants found.</td></tr>');
  $('#updateRows').html('<tr><td>New joinees</td><td>'+d.Joinees+'</td><td><a href="NewJoineeReport.aspx">View details</a></td></tr><tr><td>Leave records</td><td>'+d.Leaves+'</td><td><a href="AbscondingAndLeaveReport.aspx">View details</a></td></tr><tr><td>Absconding</td><td>'+d.Absconding+'</td><td><a href="AbscondingEmployeeFollowup.aspx">Follow up</a></td></tr>');
 }).fail(function(){$('#requisitionRows,#applicantRows,#updateRows').html('<span class="text-danger">Unable to load live HR data.</span>');});
});
</script>
</asp:Content>
