<%@ Page Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="TeamMaster.aspx.cs" Inherits="WebPortal.Admin.TeamMaster" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><link rel="stylesheet" href="../plugins/select2/css/select2.min.css"/><link rel="stylesheet" href="TeamMeeting.css?v=1" /><link rel="stylesheet" href="TeamMeetingTheme.css?v=1" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><main class="tmm-page"><div class="tmm-shell"><section class="tmm-card"><div class="tmm-body"><header class="tmm-header"><div><h1>Team Master</h1><p>Configure project teams and employee membership</p></div></header><div id="tmmMessage" class="tmm-message"></div><section class="tmm-section"><h2>Team Details</h2><input type="hidden" id="tmId" value="0"/><div class="tmm-row"><div class="tmm-field"><label class="tmm-label">Team Name <span class="tmm-required">*</span></label><input id="tmName" class="tmm-control" maxlength="150"/></div><div class="tmm-field"><label class="tmm-label">Project <span class="tmm-required">*</span></label><select id="tmProject" class="tmm-control"></select></div></div><div class="tmm-row"><div class="tmm-field"><label class="tmm-label">Team Manager</label><select id="tmManager" class="tmm-control"></select></div><div class="tmm-field"><label class="tmm-label">Status</label><select id="tmActive" class="tmm-control"><option value="true">Active</option><option value="false">Inactive</option></select></div></div><div class="tmm-field"><label class="tmm-label">Description</label><textarea id="tmDescription" class="tmm-control" maxlength="1000"></textarea></div><div class="tmm-field"><label class="tmm-label">Employees</label><select id="tmEmployees" class="tmm-control" multiple style="min-height:130px"></select></div><div class="tmm-actions"><button class="tmm-btn" type="button" id="tmReset">Cancel</button><button class="tmm-btn tmm-btn-dark" type="button" id="tmSave">Save Team</button></div></section><section class="tmm-section"><div class="tmm-attendance-head"><h2>Teams</h2><label class="tmm-check"><input type="checkbox" id="tmShowInactive"/> Show inactive</label></div><div class="tmm-table-wrap"><table id="tmTable" class="tmm-table"><thead><tr><th>Team</th><th>Project</th><th>Manager</th><th>Employees</th><th>Status</th><th>Action</th></tr></thead><tbody></tbody></table></div></section></div></section></div></main><div id="tmmLoading" class="tmm-loading"><span class="tmm-spinner"></span></div><script src="../plugins/select2/js/select2.full.min.js"></script><script src="TeamMaster.js?v=1"></script></asp:Content>
