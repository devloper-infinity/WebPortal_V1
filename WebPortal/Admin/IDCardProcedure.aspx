<%@ Page Title="ID Card Procedure" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="IDCardProcedure.aspx.cs" Inherits="WebPortal.Admin.IDCardProcedure" %>
<asp:Content ID="h" ContentPlaceHolderID="head" runat="server"><link rel="stylesheet" href="../plugins/toastr/toastr.min.css"/><link rel="stylesheet" href="../Content/erp-modern-common.css"/><style>.idc-table{width:100%!important;white-space:nowrap}.idc-loader{display:none;position:fixed;inset:0;z-index:9999;background:#ffffffbb}.idc-loader span{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}.idc-actions{margin-bottom:16px}.nav-tabs{margin-bottom:15px}</style></asp:Content>
<asp:Content ID="b" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div id="idcLoader" class="idc-loader"><span><i class="fas fa-spinner fa-spin"></i> Processing...</span></div><div class="container-fluid"><div class="erp-dashboard-header"><div class="erp-dashboard-header-content"><div class="erp-dashboard-icon"><i class="fas fa-id-badge"></i></div><div><h1 class="erp-dashboard-title">ID Card Procedure</h1><p class="erp-dashboard-subtitle">Process, track, and report employee ID card requests.</p></div></div></div><section class="erp-section-card p-3"><ul class="nav nav-tabs" id="idcTabs"></ul><div class="tab-content" id="idcContent"></div></section></div><script src="../plugins/toastr/toastr.min.js"></script><script>
(function(){var ds=[['New','New',1,['Will provide after 3 months','Pending','Inprocess','Not Provided','Reissue','Temporary']],['InProcess','In Process',1,['Not Provided','Provided','Reissue']],['Issued','Issued',0,[]],['Dropout','Dropout Employee',1,['Absconded','Terminated','Resigned']],['Report','Report',0,[]]],tables={};function esc(x){return $('<div>').text(x==null?'':x).html();}function init(){var tabs='',body='';$.each(ds,function(i,d){tabs+='<li class="nav-item"><a class="nav-link '+(i?'':'active')+'" data-toggle="tab" href="#idc'+d[0]+'">'+d[1]+'</a></li>';var form='';if(d[2]){var o='<option value="">Select</option>';$.each(d[3],function(_,x){o+='<option>'+x+'</option>';});form='<div class="row align-items-end erp-modern-form idc-actions"><div class="col-md-3"><label>Status</label><select class="form-control status">'+o+'</select></div><div class="col-md-3"><label>Sub-Status</label><select class="form-control sub"><option value="">Select</option></select></div><div class="col-md-2"><label>Date</label><input type="date" class="form-control date"/></div><div class="col-md-3"><label>Remark</label><input class="form-control remark"/></div><div class="col-md-1"><button type="button" class="btn btn-primary save">Submit</button></div></div>';}body+='<div id="idc'+d[0]+'" data-key="'+d[0]+'" class="tab-pane '+(i?'':'active')+'">'+form+'<div class="erp-table-wrap"><table class="table table-bordered idc-table"></table></div></div>';});$('#idcTabs').html(tabs);$('#idcContent').html(body);}
var visible={
New:[['Code','Code'],['FullName','Name'],['JoiningDate','Joining Date'],['CompanyName','Company'],['BranchName','Branch'],['DepartmentName','Department'],['ReportingManager','Reporting Manager'],['CellNo','Contact'],['NoOfDays','No Of Days'],['CurrentLogin','Last Login'],['Status','Status'],['SubStatus','Sub Status'],['IssuedDate','Issued Date'],['Remark','Remark'],['RemarkBy','Remark By'],['RemarkDate','Remark Date']],
InProcess:[['Code','Code'],['FullName','Name'],['JoiningDate','Joining Date'],['CompanyName','Company'],['BranchName','Branch'],['DepartmentName','Department'],['ReportingManager','Reporting Manager'],['CellNo','Contact'],['NoOfDays','No Of Days'],['Status','Status'],['SubStatus','Sub Status'],['IssuedDate','Issued Date'],['Remark','Remark'],['RemarkBy','Remark By'],['RemarkDate','Remark Date']],
Issued:[['Code','Code'],['FullName','Name'],['JoiningDate','Joining Date'],['CompanyName','Company'],['BranchName','Branch'],['DepartmentName','Department'],['ReportingManager','Reporting Manager'],['CellNo','Contact'],['NoOfDays','No Of Days'],['Status','Status'],['SubStatus','Sub Status'],['IssuedDate','Issued Date'],['Remark','Remark'],['RemarkByName','Issued By'],['RemarkDate','Remark Date']],
Dropout:[['Code','Code'],['FullName','Name'],['JoiningDate','Joining Date'],['LastWorkingDate','Last Working Date'],['CompanyName','Company'],['BranchName','Branch'],['DepartmentName','Department'],['ReportingManager','Reporting Manager'],['CellNo','Contact'],['NoOfDays','No Of Days'],['Status','Status'],['SubStatus','Sub Status'],['IssuedDate','Issued Date'],['Remark','Remark'],['RemarkByName','Issued By'],['RemarkDate','Remark Date']],
Report:[['Code','Code'],['FullName','Full Name'],['CompanyName','Company'],['BranchName','Branch'],['ReportingManager','Reporting Manager'],['JoiningDate','Joining Date'],['Status','Status'],['SubStatus','Sub Status'],['IssuedDate','Issued Date'],['Remark','Remark'],['RemarkBy','Remark By'],['Date','Remark Date']]
};
function draw(d,x){var cols=[{data:null,title:'Sr. #',orderable:false,render:function(v,t,r,m){return m.row+1;}}];$.each(visible[d[0]],function(_,f){cols.push({data:f[0],title:f[1],defaultContent:'',render:function(v,t){return t==='display'||t==='filter'?esc(v):v;}});});if(d[2])cols.unshift({data:null,title:'<input type="checkbox" class="all"/>',orderable:false,render:function(v,t,r){return'<input type="checkbox" class="rowpick" value="'+esc(r.Code)+'"/>';}});tables[d[0]]=$('#idc'+d[0]+' table').DataTable({data:x.Rows||[],columns:cols,destroy:true,scrollX:true,scrollCollapse:true,autoWidth:false,pageLength:25,dom:'Bfrtip',buttons:[{extend:'excelHtml5',className:'btn btn-success',text:'Export To Excel',title:'ID Card '+d[1]}],language:{emptyTable:'No records found'},initComplete:function(){this.api().columns.adjust();}});}
function load(){$('#idcLoader').show();$.ajax({type:'POST',url:'IDCardProcedure.aspx/GetData',data:'{}',contentType:'application/json; charset=utf-8',dataType:'json'}).done(function(r){$.each(ds,function(_,d){draw(d,r.d[d[0]]);});}).fail(function(){toastr.error('Unable to load ID card records.');}).always(function(){$('#idcLoader').hide();});}function adjust(){$.fn.dataTable.tables({visible:true,api:true}).columns.adjust();}function subs(s){return s==='Inprocess'?['Photo Pending','Waiting to get ID card from vendor']:s==='Not Provided'?['Absconded','Terminated','Resigned']:s?[s]:[];}$(function(){init();$(document).on('change','.status',function(){var o='<option value="">Select</option>';$.each(subs(this.value),function(_,x){o+='<option>'+x+'</option>';});$(this).closest('.idc-actions').find('.sub').html(o);}).on('change','.all',function(){$(this).closest('table').find('.rowpick').prop('checked',this.checked);}).on('shown.bs.tab','a[data-toggle="tab"]',adjust).on('click','.save',function(){var p=$(this).closest('.tab-pane'),codes=p.find('.rowpick:checked').map(function(){return this.value;}).get(),s=p.find('.status').val(),sub=p.find('.sub').val(),date=p.find('.date').val();if(!codes.length||!s||!sub){toastr.warning('Select employee, status and sub-status.');return;}if((s==='Provided'||s==='Reissue'||s==='Temporary')&&!date){toastr.warning('Please select date.');return;}$('#idcLoader').show();$.ajax({type:'POST',url:'IDCardProcedure.aspx/Save',data:JSON.stringify({codes:codes,status:s,subStatus:sub,issuedDate:date,remark:p.find('.remark').val()}),contentType:'application/json; charset=utf-8',dataType:'json'}).done(function(r){toastr[r.d.Success?'success':'error'](r.d.Message);if(r.d.Success)load();}).fail(function(){toastr.error('Unable to save details.');}).always(function(){$('#idcLoader').hide();});});load();});})();
</script></asp:Content>
