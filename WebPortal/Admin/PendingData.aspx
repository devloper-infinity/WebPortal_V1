<%@ Page Title="Pending Data" Language="C#" AutoEventWireup="true" CodeBehind="PendingData.aspx.cs" Inherits="WebPortal.Admin.PendingData" %>
<!DOCTYPE html><html lang="en"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Pending Data - Infinity ERP</title>
<script src="../plugins/jquery/jquery.min.js"></script><link rel="stylesheet" href="../plugins/fontawesome-free/css/all.min.css"/><link rel="stylesheet" href="../plugins/bootstrap/css/bootstrap.min.css"/><link rel="stylesheet" href="../plugins/datatables-bs4/css/dataTables.bootstrap4.min.css"/><link rel="stylesheet" href="../plugins/datatables-responsive/css/responsive.bootstrap4.min.css"/><link rel="stylesheet" href="../dist/css/adminlte.min.css"/><link rel="stylesheet" href="../Content/erp-modern-common.css"/>
<style>body{background:#f4f6f9}.pd-shell{padding:24px;max-width:100%}.pd-topbar{display:flex;align-items:center;justify-content:space-between;background:#172554;color:#fff;padding:14px 24px;box-shadow:0 3px 12px rgba(15,23,42,.18)}.pd-brand{font-size:20px;font-weight:700}.pd-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 8px 24px rgba(15,23,42,.06);padding:20px;width:100%}.pd-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}.pd-table-wrap{width:100%;overflow-x:auto}.pd-loading{display:none;position:fixed;inset:0;z-index:20000;background:rgba(15,23,42,.55);align-items:center;justify-content:center}.pd-loading.show{display:flex}.pd-loading-box{background:#fff;border-radius:10px;padding:24px 34px;text-align:center}.pd-spinner{width:34px;height:34px;margin:0 auto 12px;border:4px solid #dbeafe;border-top-color:#2563eb;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.pd-message{display:none}.modal textarea{min-height:120px}.dataTables_wrapper,#pendingTable{width:100%!important}@media(max-width:576px){.pd-shell{padding:12px}.pd-toolbar{align-items:flex-start;flex-direction:column}}</style></head>
<body><form id="pendingDataForm" runat="server"><header class="pd-topbar"><div class="pd-brand"><i class="fas fa-layer-group mr-2"></i>Infinity ERP</div><a class="btn btn-sm btn-outline-light" href="../Logout.aspx"><i class="fas fa-sign-out-alt mr-1"></i>Logout</a></header>
<main class="pd-shell"><div class="erp-dashboard-header"><div class="erp-dashboard-header-content"><div class="erp-dashboard-icon"><i class="fas fa-clipboard-check"></i></div><div><h1 class="erp-dashboard-title">Pending Data</h1><p class="erp-dashboard-subtitle">Complete missing project data or record a temporary pending reason before continuing.</p></div></div></div><div id="pdMessage" class="alert pd-message" role="alert"></div><section class="pd-card"><div class="pd-toolbar"><strong><span id="pendingCount">0</span> pending item(s)</strong><button id="refreshPending" type="button" class="btn btn-primary"><i class="fas fa-sync-alt"></i> Refresh</button></div><div class="pd-table-wrap"><table id="pendingTable" class="table table-striped table-bordered table-hover"><thead><tr><th>Project</th><th>Order / Loan</th><th>Order Date</th><th>Missing Field</th><th>Actions</th></tr></thead><tbody></tbody></table></div></section></main>
<div class="modal fade" id="remarkModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Mark temporarily pending</h5><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div><div class="modal-body"><p id="remarkItem" class="text-muted"></p><label for="remarkText">Reason <span class="text-danger">*</span></label><textarea id="remarkText" class="form-control" maxlength="1000"></textarea><div id="remarkValidation" class="text-danger mt-2"></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button><button id="saveRemark" type="button" class="btn btn-warning">Save pending reason</button></div></div></div></div>
<div class="modal fade" id="historyModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Remark history</h5><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div><div class="modal-body"><div class="table-responsive"><table class="table table-sm table-bordered"><thead><tr><th>Remark</th><th>Added date</th><th>Added by</th><th>Status</th></tr></thead><tbody id="historyBody"></tbody></table></div></div></div></div></div><div id="pdLoading" class="pd-loading"><div class="pd-loading-box"><div class="pd-spinner"></div><span id="pdLoadingText">Loading...</span></div></div></form>
<script src="../plugins/bootstrap/js/bootstrap.bundle.min.js"></script><script src="../plugins/datatables/jquery.dataTables.min.js"></script><script src="../plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script><script src="../plugins/datatables-responsive/js/dataTables.responsive.min.js"></script><script src="../plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
<script>
(function(){'use strict';var table,current,loading=0,root='<%= ResolveUrl("~/") %>';function esc(v){return $('<div>').text(v==null?'':v).html()}function busy(t){loading++;$('#pdLoadingText').text(t||'Loading...');$('#pdLoading').addClass('show')}function done(){loading=Math.max(0,loading-1);if(!loading)$('#pdLoading').removeClass('show')}function msg(t,ok){$('#pdMessage').removeClass('alert-success alert-danger').addClass(ok?'alert-success':'alert-danger').text(t).show()}async function call(n,d,t){busy(t);try{var r=await fetch(root+'Admin/PendingData.aspx/'+n,{method:'POST',cache:'no-store',credentials:'same-origin',headers:{'Content-Type':'application/json','Cache-Control':'no-cache'},body:JSON.stringify(d||{})});if(r.status===401){location.href=root+'Login.aspx';return}var x;try{x=await r.json()}catch(_){throw Error('Unable to load pending data. Please refresh the page.')}if(!r.ok)throw Error(x.Message||'Request failed.');return x.d}finally{done()}}function render(x){if(!x)return;$('#pendingCount').text(x.count);table.clear().rows.add(x.rows).draw();if(!x.count){msg('All pending data is cleared. Redirecting to ERP dashboard...',true);setTimeout(function(){location.href=root+'Admin/DashboardEmployee.aspx'},900)}}async function load(){try{render(await call('LoadPending',{},'Checking pending data...'))}catch(e){msg(e.message,false)}}function buttons(r){return '<button type="button" class="btn btn-sm btn-warning js-remark" data-p="'+encodeURIComponent(r.ProjectID)+'" data-o="'+encodeURIComponent(r.OrderNo||'')+'">Remark / Pending</button> <button type="button" class="btn btn-sm btn-outline-info js-history" data-p="'+encodeURIComponent(r.ProjectID)+'" data-o="'+encodeURIComponent(r.OrderNo||'')+'">History</button>'}$(function(){table=$('#pendingTable').DataTable({data:[],responsive:true,autoWidth:false,pageLength:25,order:[[0,'asc'],[2,'asc']],columns:[{data:'ProjectName',render:function(v,t,r){return t==='display'?'<strong>'+esc(v)+'</strong><br><small class="text-muted">ID: '+esc(r.ProjectID)+'</small>':v}},{data:'OrderNo',defaultContent:''},{data:'OrderDate',render:function(v){if(!v)return '';var m=/Date\((\d+)\)/.exec(v);return m?new Date(+m[1]).toLocaleDateString():esc(v)}},{data:'MissingField',defaultContent:''},{data:null,orderable:false,searchable:false,render:function(v,t,r){return t==='display'?buttons(r):''}}]});$('#refreshPending').on('click',function(e){e.preventDefault();load()});$('#pendingTable').on('click','.js-remark',function(e){e.preventDefault();current={ProjectID:+decodeURIComponent(this.dataset.p),OrderNo:decodeURIComponent(this.dataset.o)};$('#remarkItem').text('Project '+current.ProjectID+' / '+current.OrderNo);$('#remarkText').val('');$('#remarkValidation').text('');$('#remarkModal').modal('show')}).on('click','.js-history',async function(e){e.preventDefault();try{var a=await call('LoadHistory',{projectId:+decodeURIComponent(this.dataset.p),orderNo:decodeURIComponent(this.dataset.o)},'Loading history...');$('#historyBody').html(a.length?a.map(function(r){return '<tr><td>'+esc(r.Remark)+'</td><td>'+esc(r.AddedDate)+'</td><td>'+esc(r.AddedBy)+'</td><td>'+(r.IsActive?'Active':'Inactive')+'</td></tr>'}).join(''):'<tr><td colspan="4" class="text-center text-muted">No history found.</td></tr>');$('#historyModal').modal('show')}catch(e){msg(e.message,false)}});$('#saveRemark').on('click',async function(e){e.preventDefault();var v=$('#remarkText').val().trim();if(v.length<3){$('#remarkValidation').text('Enter a reason of at least 3 characters.');return}try{var x=await call('SaveRemark',{input:{ProjectID:current.ProjectID,OrderNo:current.OrderNo,Remark:v}},'Saving remark...');$('#remarkModal').modal('hide');msg(x.message,true);render(x)}catch(e){$('#remarkValidation').text(e.message)}});load()})})();
</script></body></html>
