<appSettings>
  <!-- Changes are picked up without recompilation. Cache expiry bounds revocation delay. -->
  <add key="Authorization.CacheSeconds" value="60" />
  <add key="Authorization.PublicPages" value="Login.aspx,LoginNew.aspx,ForgotPassword.aspx,ResetPassword.aspx,Logout.aspx,LogoutNew.aspx" />
  <add key="Authorization.CommonPages" value="SessionKeepAlive.aspx,MenuService.aspx,Admin/DashboardEmployee.aspx" />
  <!-- Shared master-page operations available to every authenticated user. Keep this method-specific. -->
  <add key="Authorization.CommonMethods" value="Admin/DashboardEmployee.aspx/GetPendingTask,Admin/FestivalsWishesMasterForAdmin.aspx/GetPopUpWishForCurrentUser,OperationsBulletin/Dashboard.aspx/GetBulletins,OperationsBulletin/Dashboard.aspx/Track" />
