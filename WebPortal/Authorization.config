  <add key="Authorization.PagePermissions" value="Accounts/ApprovedEmployee.aspx=Accounts/ProfileApproval.aspx;Admin/AgreementVersionsHistoryReport.aspx=Admin/AgreementVersionControl.aspx;Admin/Log.aspx=Admin/ChildPages.aspx;Admin/GenerateEmpDocs.aspx=Admin/DropoutEmployeeReport.aspx;Admin/ImportFeedback.aspx=Admin/InfinityFeedback.aspx;Admin/SyncInternalFeedback.aspx=Admin/InfinityFeedback.aspx;Admin/ViewLog.aspx=Admin/LogInDetails.aspx|Admin/ProposedSalaryReport.aspx;Admin/ExcelBillingReport.aspx=Admin/OtherBilling.aspx;Admin/RNRReport.aspx=Admin/RNRAdmin.aspx;Admin/SecuritizationBillingSent.aspx=Admin/SecuritizationBilling.aspx;Admin/EditSecuritizationTracking.aspx=Admin/SecuritizationTracking.aspx;Admin/ImportSecuritizationLoans.aspx=Admin/SecuritizationTracking.aspx;Admin/UserPerformanceReportMarketing.aspx=Admin/UserPerformanceReport.aspx;Admin/AddApplicantRemark.aspx=Admin/ViewAllApplicantList.aspx|Admin/ViewSelectedCandidates.aspx;Admin/CreateProfile.aspx=Admin/ViewSelectedCandidates.aspx;Assets/AssetDetails.aspx=Assets/AddAsset.aspx|Assets/AssetAllocationHistory.aspx|Assets/AssetDisposal.aspx|Assets/AssetDisposalReport.aspx|Assets/AssetMaintenanceHistory.aspx|Assets/AssetPurchaseReport.aspx|Assets/AssetReturn.aspx|Assets/AssetStockReport.aspx|Assets/AssetTransferHistory.aspx|Assets/EmployeeAssetReport.aspx|Assets/EmployeeITDetails.aspx|Assets/MaintenanceCostReport.aspx|Assets/ViewAssets.aspx|Assets/WarrantyExpiryReport.aspx;CRM/Settings.aspx=CRM/Dashboard.aspx;IT/AddTicketRemark.aspx=IT/TicketQueue.aspx;OperationsBulletin/Manage.aspx=OperationsBulletin/Dashboard.aspx;OperationsBulletin/AccessDenied.aspx=OperationsBulletin/Dashboard.aspx;Production/ProjectTrackingSheet.aspx=Production/ProjectTrackingFieldConfiguration.aspx;Search/Costing.aspx=Search/ProcessOrders.aspx|Search/SearchDashboard.aspx;TrackingSheet/TrackingSheetFeedback.aspx=TrackingSheet/TrackingSheet.aspx;US/FeedbackDetails.aspx=US/GlobalSearch.aspx|US/LoanDetails.aspx;US/AddFeedback.aspx=US/LoanDetails.aspx;US/CanopySearch.aspx=US/LoanDetails.aspx;US/Dashboard.aspx=US/LoanDetails.aspx;US/FeedbackCanopyDetails.aspx=US/LoanDetails.aspx;US/MyQueue.aspx=US/LoanDetails.aspx;OST/DownloadFile.aspx=Vendor/ProjectTrackingReportVM.aspx;Vendor/ProcessOrderPMPopup.aspx=Vendor/ProjectTrackingReportVM.aspx;Vendor/ProcessOrderPopup.aspx=Vendor/ProjectTrackingReportVM.aspx;Vendor/VMEditOrders.aspx=Vendor/ProjectTrackingReportVM.aspx;Vendor/ProjectWiseSummary.aspx=Vendor/VendorBillingGeneratePeriod.aspx;Vendor/VendorBillingDetails.aspx=Vendor/VendorFeedbackReport.aspx" />
  <!-- Format: page.aspx/method=required-menu-page.aspx;...; unspecified methods require their page permission. -->
  <add key="Authorization.MethodPermissions" value="Admin/ImportFeedback.aspx/GetUserInfo=Admin/InfinityFeedback.aspx;Admin/UserLeaves.aspx/BindUserLeaves=Admin/EmployeeLeaves.aspx;Admin/CreateProfile.aspx/GetBranches=Admin/ExpensesAdmin.aspx;Admin/CreateProfile.aspx/GetAllDomains=Admin/PMWiseAttritionReport.aspx;Admin/CreateProfile.aspx/GetBankNames=Admin/ApprovedBankDeatils.aspx;Admin/HRReportInput.aspx/GetAllEmployees=Admin/ApprovedBankDeatils.aspx;Admin/Securitization561.aspx/GetDealData=Admin/SecuritizationTracking.aspx;Admin/Securitization561.aspx/GetDealDetails=Admin/SecuritizationTracking.aspx;US/EditDailyLogin.aspx/DeleteUserWiseOnshoreDailyBreakInOut=US/DailyLogin.aspx;US/EditDailyLogin.aspx/DeleteUserWiseOnshoreDailyLogin=US/DailyLogin.aspx;US/EditDailyLogin.aspx/GetAllEmpOnshoreDailyLogs=US/DailyLogin.aspx;US/EditDailyLogin.aspx/GetOnshoreEditDailyLogsBreakInOut=US/DailyLogin.aspx;US/EditDailyLogin.aspx/UpdateOnshoreBreakInOut=US/DailyLogin.aspx;US/EditDailyLogin.aspx/UpdateOnshoreLogin=US/DailyLogin.aspx;US/AddFeedback.aspx/GetCollectionCommentsDataFields=US/LoanDetails.aspx;US/AddFeedback.aspx/GetCollectionCommentsFeedback_ByUser=US/LoanDetails.aspx;US/AddFeedback.aspx/GetLoanDetails_RemoteUW_ByID=US/LoanDetails.aspx;US/AddFeedback.aspx/GetUSImportedFeedback_ByUser_NewERP=US/LoanDetails.aspx;US/CanopySearch.aspx/GetLoansForGlobalSearch=US/LoanDetails.aspx" />
