    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link rel="stylesheet" href="AccountsModern.css" />
    <script>
        $(document).ready(function () {

            $.ajax({
                type: "POST",
                url: "../MenuService.aspx/LoadMenu",
                contentType: "application/json",
                dataType: "json",
                success: function (res) {
                    let menuTree = res.d;
                    let html = "";
                    menuTree.forEach(m => html += renderTopMenu(m));
                    $("#dynamicMenu").html(html);
                }
            });

        });

        // ----------------- Top Level Menu --------------------
        function renderTopMenu(menu) {
            let hasChildren = menu.Children.length > 0;

            if (!hasChildren) {
                return `
            <li class="nav-item">
                <a href="${menu.Url || '#'}" class="nav-link">${menu.MenuName}</a>
            </li>`;
            }

            // Mega-menu detection: if children have SectionName
            let isMega = menu.Children.some(x => x.SectionName);

            if (!isMega) {
                // Simple dropdown
                return `
            <li class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">${menu.MenuName}</a>
                <ul class="dropdown-menu border-0 shadow">
                    ${menu.Children.map(renderSimpleItem).join("")}
                </ul>
            </li>`;
            }

            // --------------- MEGA MENU ----------------
            return `
        <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">${menu.MenuName}</a>
            <ul class="dropdown-menu border-0 shadow" style="width:700px; left:50%;">
                <div class="col-sm-12">
                    <div class="row">
                        ${renderMegaSections(menu.Children)}
                    </div>
                </div>
            </ul>
        </li>`;
        }

        // ------------------ Simple Dropdown Items ----------------------
        function renderSimpleItem(item) {
            if (item.Children.length === 0) {
                return `<li><a class="dropdown-item" href="${item.Url || '#'}">${item.MenuName}</a></li>`;
            }
            return ""; // no nesting for simple menus
        }

        // ------------------ Mega Menu Sections & Items -----------------
        function renderMegaSections(children) {

            let html = "";

            children.forEach(section => {

                // ✅ If this is a SECTION (has children)
                if (section.Children && section.Children.length > 0) {

                    html += `
                <div class="col-sm-4">
                    <div class="callout callout-info" style="margin-bottom:10px; padding:0 5px;">
                        <h6 class="m-0"><b>${section.MenuName}</b></h6>
                    </div>

                    ${section.Children.map(item => `
                        <a href="${item.Url || '#'}" class="dropdown-item">${item.MenuName}</a>
                    `).join("")}
                </div>`;
                }
            });

            return html;
        }
    </script>
</head>
