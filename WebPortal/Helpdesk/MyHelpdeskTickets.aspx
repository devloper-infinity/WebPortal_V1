<%@ Page Title="My Helpdesk Requests" Language="C#" MasterPageFile="~/Helpdesk/IHMSPage.Master" AutoEventWireup="true" CodeBehind="MyHelpdeskTickets.aspx.cs" Inherits="WebPortal.Helpdesk.MyHelpdeskTickets" %>
<asp:Content ID="B" ContentPlaceHolderID="HelpdeskBody" runat="server"><div class="row"><div class="col-lg-5"><div class="panel"><div class="panel-title">Raise ticket</div><div class="panel-body"><div class="form-group"><label>Request type</label><select id="type" class="form-control"></select></div><div class="form-group"><label>Priority</label><select id="priority" class="form-control"></select></div><div class="form-group"><label>Location</label><input id="location" maxlength="150" class="form-control" /></div><div class="form-group"><label>Subject *</label><input id="subject" maxlength="300" class="form-control" /></div><div class="form-group"><label>Description *</label><textarea id="description" rows="6" class="form-control"></textarea></div><button class="btn btn-primary" onclick="createTicket()">Submit ticket</button></div></div></div><div class="col-lg-7"><div class="panel"><div class="panel-title">My tickets</div><div class="table-wrap"><table id="grid" class="table table-striped"></table></div></div></div></div></asp:Content>
<asp:Content ID="S" ContentPlaceHolderID="HelpdeskScripts" runat="server"><script>IHMS.shell('My Helpdesk Tickets','Raise and follow your IT requests');function boot(){IHMS.post('MyHelpdeskTickets.aspx/Bootstrap',{},function(d){var t='<option value="">Select</option>';d[0].filter(x=>x.IsActive).forEach(x=>t+='<option value="'+x.RequestTypeID+'">'+IHMS.esc(x.Name)+'</option>');$('#type').html(t);var p='';d[2].forEach(x=>p+='<option value="'+x.PriorityCode+'">'+IHMS.esc(x.PriorityName)+'</option>');$('#priority').html(p);load()})}function load(){IHMS.post('MyHelpdeskTickets.aspx/List',{},function(r){IHMS.table('#grid',r,[['Ticket','TicketNo',IHMS.ticketLink],['Subject','Subject'],['Priority','PriorityName',IHMS.priority],['Status','StatusName',IHMS.status],['Updated','ModifiedDate']])})}function createTicket(){IHMS.post('MyHelpdeskTickets.aspx/Create',{requestTypeId:$('#type').val()?+$('#type').val():null,priority:$('#priority').val(),location:$('#location').val(),subject:$('#subject').val(),description:$('#description').val()},function(r){IHMS.toast('Ticket '+r[0].TicketNo+' created');$('#subject,#description').val('');load()})}$(boot);</script></asp:Content>
