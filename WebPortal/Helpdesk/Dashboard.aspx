<%@ Page Title="Helpdesk Dashboard" Language="C#" MasterPageFile="~/Helpdesk/IHMSPage.Master" AutoEventWireup="true" CodeBehind="Dashboard.aspx.cs" Inherits="WebPortal.Helpdesk.Dashboard" %>
<asp:Content ID="B" ContentPlaceHolderID="HelpdeskBody" runat="server"><div id="cards" class="cards"></div><div class="row"><div class="col-lg-4"><div class="panel"><div class="panel-title">Status-wise</div><div class="panel-body"><canvas id="statusChart"></canvas></div></div></div><div class="col-lg-4"><div class="panel"><div class="panel-title">Request type-wise</div><div class="panel-body"><canvas id="typeChart"></canvas></div></div></div><div class="col-lg-4"><div class="panel"><div class="panel-title">Priority-wise</div><div class="panel-body"><canvas id="priorityChart"></canvas></div></div></div></div><div class="panel"><div class="panel-title">Created vs closed (30 days)</div><div class="panel-body"><canvas id="trendChart"></canvas></div></div></asp:Content>
<asp:Content ID="S" ContentPlaceHolderID="HelpdeskScripts" runat="server"><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script><script>IHMS.shell('IT Helpdesk Dashboard','Live workload and SLA health');IHMS.post('Dashboard.aspx/Get',{},function(d){var c=d[0][0]||{},names=[['New','NewCount'],['Open','OpenCount'],['Assigned','AssignedCount'],['In Progress','InProgressCount'],['Pending User','PendingUserCount'],['Pending Approval','PendingApprovalCount'],['Resolved Today','ResolvedToday'],['Closed Today','ClosedToday'],['Overdue','OverdueCount'],['Total','TotalCount']],h='';names.forEach(function(x){h+='<div class="metric"><span>'+x[0]+'</span><strong>'+ (c[x[1]]||0)+'</strong></div>'});$('#cards').html(h);pie('statusChart',d[1]);pie('typeChart',d[2]);pie('priorityChart',d[3]);var t=d[4]||[];new Chart(document.getElementById('trendChart'),{type:'line',data:{labels:t.map(x=>x.Day),datasets:[{label:'Created',data:t.map(x=>x.Created),borderColor:'#1572a1'},{label:'Closed',data:t.map(x=>x.Closed),borderColor:'#239b6c'}]}})});function pie(id,r){new Chart(document.getElementById(id),{type:'doughnut',data:{labels:(r||[]).map(x=>x.Label),datasets:[{data:(r||[]).map(x=>x.Value)}]}})}</script></asp:Content>
