<%@ Page Title="My IT Tickets" Language="C#" MasterPageFile="~/Helpdesk/IHMSPage.Master" AutoEventWireup="true" CodeBehind="MyTickets.aspx.cs" Inherits="WebPortal.Helpdesk.MyTickets" %>
<asp:Content ID="B" ContentPlaceHolderID="HelpdeskBody" runat="server"><div class="panel"><div class="panel-body"><div class="filters"><div><label>View</label><select id="scope" class="form-control"><option value="Mine">Assigned To Me</option><option value="Bucket">Main Bucket</option><option value="All">All IT tickets</option></select></div><div><label>Status</label><select id="status" class="form-control"><option value="">All / Open</option><option value="InProgress">In Progress</option><option value="PendingUser">Pending User</option><option value="PendingApproval">Pending Approval</option><option value="Resolved">Resolved</option><option value="Closed">Closed</option></select></div><button type="button" class="btn btn-primary" onclick="loadTickets()">Apply</button></div></div><div class="table-wrap"><table id="grid" class="table table-striped table-hover"></table></div></div></asp:Content>
<asp:Content ID="S" ContentPlaceHolderID="HelpdeskScripts" runat="server"><script>IHMS.shell('IT My Tickets','Assigned work and main bucket');function loadTickets(){IHMS.post('MyTickets.aspx/Get',{scope:$('#scope').val(),status:$('#status').val()},function(r){IHMS.table('#grid',r,[['Ticket','TicketNo',IHMS.ticketLink],['Subject','Subject'],['Requestor','RequestorName'],['Type','RequestType'],['Priority','PriorityName',IHMS.priority],['Status','StatusName',IHMS.status],['SLA due','SLADueDate'],['Updated','ModifiedDate']])})}function boot(){IHMS.post('MyTickets.aspx/Bootstrap',{},function(d){var roles=(d[3]||[]).map(function(x){return x.RoleCode;});if(roles.indexOf('HelpdeskAdmin')>=0||roles.indexOf('ITHead')>=0)$('#scope').val('Bucket');loadTickets()})}$(boot);</script></asp:Content>
