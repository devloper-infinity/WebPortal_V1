<%@ Page Title="Ticket Details" Language="C#" MasterPageFile="~/Helpdesk/IHMSPage.Master" AutoEventWireup="true" CodeBehind="TicketDetails.aspx.cs" Inherits="WebPortal.Helpdesk.TicketDetails" %>
<asp:Content ID="B" ContentPlaceHolderID="HelpdeskBody" runat="server"><div id="ticket"></div><div class="row"><div class="col-lg-8"><div class="panel"><div class="panel-title">Activity timeline</div><div class="panel-body"><div id="timeline" class="timeline"></div></div></div></div><div class="col-lg-4"><div class="panel"><div class="panel-title">Actions</div><div class="panel-body"><div id="lock" class="alert alert-warning" style="display:none">Locked while approval is pending.</div><div class="form-group"><label>Request type</label><select id="type" class="form-control"></select></div><div class="form-group"><label>Assign employee ID</label><input id="assign" type="number" class="form-control" /></div><div class="form-group"><label>Status</label><select id="status" class="form-control"></select></div><div class="form-group"><label>Remark / note</label><textarea id="remark" rows="4" class="form-control"></textarea></div><div class="actions"><button class="btn btn-primary edit" onclick="changeType()">Change type</button><button class="btn btn-primary edit" onclick="assign()">Assign / Reassign</button><button class="btn btn-primary edit" onclick="transition()">Change status</button><button class="btn btn-info edit" onclick="remark(false)">Public remark</button><button class="btn btn-warning edit" onclick="remark(true)">Internal note</button></div><hr/><div class="form-group"><label>Approver employee ID</label><input id="approver" type="number" class="form-control edit" /></div><button class="btn btn-secondary edit" onclick="approval()">Send approval</button><hr/><form id="upload"><input type="file" name="file" class="form-control-file edit" /><label><input type="checkbox" name="internalNote" value="true" class="edit" /> Internal</label><button class="btn btn-outline-primary btn-sm edit">Upload</button></form></div></div><div class="panel"><div class="panel-title">Attachments</div><div id="attachments" class="panel-body"></div></div></div></div></asp:Content>
<asp:Content ID="S" ContentPlaceHolderID="HelpdeskScripts" runat="server"><script>var id=+(new URLSearchParams(location.search).get('id')||0),locked=false;IHMS.shell('Ticket Details','Full history, files and controlled actions');function load(){IHMS.post('TicketDetails.aspx/Get',{ticketId:id},function(d){var x=d[0][0];if(!x){IHMS.toast('Ticket not found',true);return}locked=x.StatusCode==='PendingApproval';$('#lock').toggle(locked);$('.edit').prop('disabled',locked);$('#ticket').html('<div class="panel"><div class="panel-body"><h3>'+IHMS.esc(x.TicketNo)+' <small>'+IHMS.status(x.StatusName)+' '+IHMS.priority(x.PriorityName)+'</small></h3><h4>'+IHMS.esc(x.Subject)+'</h4><div class="row"><div class="col-md-4"><b>Requestor</b><br>'+IHMS.esc(x.RequestorName)+'<br>'+IHMS.esc(x.RequestorEmail)+'</div><div class="col-md-4"><b>Department / Location</b><br>'+IHMS.esc(x.Department)+' / '+IHMS.esc(x.Location)+'</div><div class="col-md-4"><b>Type / Assigned</b><br>'+IHMS.esc(x.RequestType)+' / '+IHMS.esc(x.AssignedToEmployeeID||'Main Bucket')+'</div></div><hr><div style="white-space:pre-wrap">'+IHMS.esc(x.Description)+'</div><hr><small>Created '+IHMS.esc(x.CreatedDate)+' · Updated '+IHMS.esc(x.ModifiedDate)+' · SLA due '+IHMS.esc(x.SLADueDate||'Not configured')+'</small></div></div>');var h='';d[1].forEach(function(a){h+='<div class="event '+(a.IsInternal?'internal':'')+'"><b>'+IHMS.esc(a.ActivityType)+'</b> '+IHMS.esc(a.OldValue||'')+(a.OldValue?' → ':'')+IHMS.esc(a.NewValue||'')+'<div>'+IHMS.esc(a.Details||'')+'</div><small>'+IHMS.esc(a.PerformedName||a.PerformedBy||'System')+' · '+IHMS.esc(a.PerformedDate)+'</small></div>'});$('#timeline').html(h||'No activity');$('#attachments').html(d[2].map(a=>'<div><i class="fas fa-paperclip"></i> '+IHMS.esc(a.OriginalFileName)+' <small>'+IHMS.esc(a.UploadedDate)+'</small></div>').join('')||'None');masters()})}function masters(){IHMS.post('TicketDetails.aspx/Masters',{},function(d){$('#type').html(d[0].filter(x=>x.IsActive).map(x=>'<option value="'+x.RequestTypeID+'">'+IHMS.esc(x.Name)+'</option>').join(''));$('#status').html(d[1].map(x=>'<option value="'+x.StatusCode+'">'+IHMS.esc(x.StatusName)+'</option>').join(''))})}function done(){IHMS.toast('Ticket updated');$('#remark').val('');load()}function changeType(){IHMS.post('TicketDetails.aspx/ChangeType',{ticketId:id,requestTypeId:+$('#type').val()},done)}function assign(){IHMS.post('TicketDetails.aspx/Assign',{ticketId:id,employeeId:+$('#assign').val()},done)}function transition(){IHMS.post('TicketDetails.aspx/Transition',{ticketId:id,status:$('#status').val(),remark:$('#remark').val()},done)}function remark(i){IHMS.post('TicketDetails.aspx/AddRemark',{ticketId:id,remark:$('#remark').val(),internalNote:i},done)}function approval(){IHMS.post('TicketDetails.aspx/RequestApproval',{ticketId:id,approverId:+$('#approver').val(),remark:$('#remark').val()},done)}$('#upload').on('submit',function(e){e.preventDefault();var f=new FormData(this);f.append('ticketId',id);$.ajax({url:'TicketDetails.aspx?upload=1',method:'POST',data:f,processData:false,contentType:false}).done(done).fail(function(x){IHMS.toast(x.responseText||'Upload failed',true)})});$(load);</script></asp:Content>
