<%@ Page Title="Ticket Approvals" Language="C#" MasterPageFile="~/Helpdesk/IHMSPage.Master" AutoEventWireup="true" CodeBehind="TicketApproval.aspx.cs" Inherits="WebPortal.Helpdesk.TicketApproval" %>
<asp:Content ID="B" ContentPlaceHolderID="HelpdeskBody" runat="server"><div class="panel"><div class="panel-body"><div class="btn-group"><button class="btn btn-outline-primary" onclick="load('Pending')">Pending</button><button class="btn btn-outline-success" onclick="load('Approved')">Approved</button><button class="btn btn-outline-danger" onclick="load('Rejected')">Rejected</button></div></div><div class="table-wrap"><table id="grid" class="table table-striped"></table></div></div><div class="modal fade" id="decision"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>Approval decision</h5></div><div class="modal-body"><input type="hidden" id="approvalId"><textarea id="decisionRemark" class="form-control" rows="5" placeholder="Mandatory decision remark"></textarea></div><div class="modal-footer"><button class="btn btn-success" onclick="decide('Approved')">Approve</button><button class="btn btn-danger" onclick="decide('Rejected')">Reject</button></div></div></div></div></asp:Content>
<asp:Content ID="S" ContentPlaceHolderID="HelpdeskScripts" runat="server"><script>IHMS.shell('Ticket Approvals','Pending, approved and rejected requests');function load(s){IHMS.post('TicketApproval.aspx/List',{decision:s},function(r){IHMS.table('#grid',r,[['Ticket','TicketNo',function(v,x){return '<a href="TicketDetails.aspx?id='+x.TicketID+'">'+IHMS.esc(v)+'</a>'}],['Subject','Subject'],['Requestor','RequestorName'],['Type','RequestType'],['Priority','PriorityName',IHMS.priority],['Requested','RequestedDate'],['Status','ApprovalStatus',function(v,x){return v==='Pending'?'<button class="btn btn-sm btn-primary" onclick="openDecision('+x.ApprovalID+')">Decide</button>':IHMS.status(v)}]])})}function openDecision(id){$('#approvalId').val(id);$('#decision').modal('show')}function decide(d){var r=$('#decisionRemark').val();if(!r.trim()){IHMS.toast('Decision remark is mandatory',true);return}IHMS.post('TicketApproval.aspx/Decide',{approvalId:+$('#approvalId').val(),decision:d,remark:r},function(){$('#decision').modal('hide');load('Pending')})}$(function(){load('Pending')});</script></asp:Content>
