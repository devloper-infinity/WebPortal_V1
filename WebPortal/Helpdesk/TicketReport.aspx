<%@ Page Title="Helpdesk Report" Language="C#" MasterPageFile="~/Helpdesk/IHMSPage.Master" AutoEventWireup="true" CodeBehind="TicketReport.aspx.cs" Inherits="WebPortal.Helpdesk.TicketReport" %>
<asp:Content ID="B" ContentPlaceHolderID="HelpdeskBody" runat="server"><div class="panel"><div class="panel-body"><div class="filters"><div><label>Ticket No</label><input id="ticketNo" class="form-control"></div><div><label>From date</label><input id="from" type="date" class="form-control"></div><div><label>To date</label><input id="to" type="date" class="form-control"></div><div><label>Request type</label><select id="type" class="form-control"></select></div><div><label>Status</label><select id="status" class="form-control"></select></div><div><label>Priority</label><select id="priority" class="form-control"></select></div><div><label>Assigned employee</label><select id="assigned" class="form-control"></select></div><div><label>Source</label><select id="source" class="form-control"><option value="">All</option><option>Portal</option><option>Email</option></select></div><div><label>Approval</label><select id="approval" class="form-control"><option value="">All</option><option>Pending</option><option>Approved</option><option>Rejected</option></select></div><button type="button" class="btn btn-primary" onclick="load()">Apply</button><button type="button" class="btn btn-success" onclick="excel()"><i class="fas fa-file-excel"></i> Excel</button></div></div><div class="table-wrap"><table id="grid" class="table table-striped table-sm"></table></div></div></asp:Content>
<asp:Content ID="S" ContentPlaceHolderID="HelpdeskScripts" runat="server"><script>IHMS.shell('Ticket List / Report','Search and export the complete helpdesk register');function args(){return{ticketNo:$('#ticketNo').val(),from:$('#from').val()||null,to:$('#to').val()||null,requestTypeId:$('#type').val()?+$('#type').val():null,status:$('#status').val(),priority:$('#priority').val(),assignedTo:$('#assigned').val()?+$('#assigned').val():null,source:$('#source').val(),approval:$('#approval').val()}}function boot(){IHMS.post('TicketReport.aspx/Masters',{},function(d){$('#type').html('<option value="">All</option>'+d[0].map(x=>'<option value="'+x.RequestTypeID+'">'+IHMS.esc(x.Name)+'</option>').join(''));$('#status').html('<option value="">All</option>'+d[1].map(x=>'<option value="'+x.StatusCode+'">'+IHMS.esc(x.StatusName)+'</option>').join(''));$('#priority').html('<option value="">All</option>'+d[2].map(x=>'<option value="'+x.PriorityCode+'">'+IHMS.esc(x.PriorityName)+'</option>').join(''));IHMS.post('TicketReport.aspx/People',{},function(p){$('#assigned').html('<option value="">All employees</option>'+p[0].map(x=>'<option value="'+x.EmployeeID+'">'+IHMS.esc(x.DisplayName)+'</option>').join(''));load()})})}function load(){IHMS.post('TicketReport.aspx/Search',args(),function(r){IHMS.table('#grid',r,[['Ticket','TicketNo',IHMS.ticketLink],['Created','CreatedDate'],['Subject','Subject'],['Requestor','RequestorName'],['Department','Department'],['Location','Location'],['Type','RequestType'],['Priority','PriorityName',IHMS.priority],['Status','StatusName',IHMS.status],['Assigned','AssignedEmployee'],['Source','Source'],['Approval','ApprovalStatus'],['SLA due','SLADueDate']])})}function excel(){var a=args(),q=[];Object.keys(a).forEach(k=>{if(a[k]!=null&&a[k]!=='')q.push(encodeURIComponent(k)+'='+encodeURIComponent(a[k]))});location='TicketReport.aspx?export=1&'+q.join('&')}$(boot);</script></asp:Content>
