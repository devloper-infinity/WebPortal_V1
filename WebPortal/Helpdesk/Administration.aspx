<%@ Page Title="Helpdesk Administration" Language="C#" MasterPageFile="~/Helpdesk/IHMSPage.Master" AutoEventWireup="true" CodeBehind="Administration.aspx.cs" Inherits="WebPortal.Helpdesk.Administration" %>
<asp:Content ID="B" ContentPlaceHolderID="HelpdeskBody" runat="server"><div class="row"><div class="col-lg-7"><div class="panel"><div class="panel-title">Request Type Master</div><div class="panel-body"><input type="hidden" id="typeId"><div class="filters"><div><label>Name</label><input id="name" maxlength="120" class="form-control"></div><div><label>Description</label><input id="description" maxlength="500" class="form-control"></div><div><label>Display order</label><input id="order" type="number" value="0" class="form-control"></div><label><input id="approval" type="checkbox"> Approval required</label><label><input id="active" type="checkbox" checked> Active</label><button class="btn btn-primary" onclick="saveType()">Save</button></div></div><div class="table-wrap"><table id="types" class="table table-striped"></table></div></div></div><div class="col-lg-5"><div class="panel"><div class="panel-title">Priority SLA Master</div><div class="panel-body"><div class="form-group"><label>Priority</label><select id="slaPriority" class="form-control"></select></div><div class="form-group"><label>First response minutes</label><input id="first" type="number" min="1" class="form-control"></div><div class="form-group"><label>Resolution minutes</label><input id="resolution" type="number" min="1" class="form-control"></div><label><input id="slaActive" type="checkbox" checked> Active</label><button class="btn btn-primary" onclick="saveSla()">Save SLA</button></div><div class="table-wrap"><table id="slas" class="table table-striped"></table></div></div></div></div></asp:Content>
<asp:Content ID="S" ContentPlaceHolderID="HelpdeskScripts" runat="server"><script>var master;IHMS.shell('Helpdesk Administration','Configurable request types and priority SLA');function load(){IHMS.post('Administration.aspx/Get',{},function(d){master=d;IHMS.table('#types',d[0],[['Name','Name',function(v,x){return '<a href="#" onclick=\'editType('+JSON.stringify(x)+');return false\'>'+IHMS.esc(v)+'</a>'}],['Description','Description'],['Approval','ApprovalRequired'],['Active','IsActive'],['Order','DisplayOrder']]);$('#slaPriority').html(d[2].map(x=>'<option value="'+x.PriorityCode+'">'+IHMS.esc(x.PriorityName)+'</option>').join(''));IHMS.table('#slas',d[4],[['Priority','PriorityName'],['First response','FirstResponseMinutes'],['Resolution','ResolutionMinutes'],['Active','IsActive']])})}function editType(x){$('#typeId').val(x.RequestTypeID);$('#name').val(x.Name);$('#description').val(x.Description);$('#order').val(x.DisplayOrder);$('#approval').prop('checked',x.ApprovalRequired);$('#active').prop('checked',x.IsActive)}function saveType(){IHMS.post('Administration.aspx/SaveType',{id:+($('#typeId').val()||0),name:$('#name').val(),description:$('#description').val(),approval:$('#approval').prop('checked'),active:$('#active').prop('checked'),order:+$('#order').val()},function(){IHMS.toast('Request type saved');load()})}function saveSla(){IHMS.post('Administration.aspx/SaveSla',{priority:$('#slaPriority').val(),first:+$('#first').val(),resolution:+$('#resolution').val(),active:$('#slaActive').prop('checked')},function(){IHMS.toast('SLA saved');load()})}$(load);</script></asp:Content>
