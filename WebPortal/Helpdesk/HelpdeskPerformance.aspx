<%@ Page Title="Helpdesk Performance" Language="C#" MasterPageFile="~/Helpdesk/IHMSPage.Master" AutoEventWireup="true" CodeBehind="HelpdeskPerformance.aspx.cs" Inherits="WebPortal.Helpdesk.HelpdeskPerformance" %>
<asp:Content ID="B" ContentPlaceHolderID="HelpdeskBody" runat="server"><div class="panel"><div class="panel-body"><div class="filters"><div><label>From</label><input id="from" type="date" class="form-control"></div><div><label>To</label><input id="to" type="date" class="form-control"></div><div><label>Employee ID</label><input id="employee" type="number" class="form-control"></div><div><label>Request type</label><select id="type" class="form-control"></select></div><div><label>Priority</label><select id="priority" class="form-control"></select></div><button class="btn btn-primary" onclick="load()">Apply</button></div></div><div class="table-wrap"><table id="grid" class="table table-striped table-sm"></table></div></div><div class="panel"><div class="panel-title">Open / Resolved / Closed by employee</div><div class="panel-body"><canvas id="chart"></canvas></div></div></asp:Content>
<asp:Content ID="S" ContentPlaceHolderID="HelpdeskScripts" runat="server"><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script><script>var chart;IHMS.shell('IT Performance','Workload, response time, resolution time and SLA');function boot(){var n=new Date(),p=new Date(n.getFullYear(),n.getMonth(),1);$('#from').val(p.toISOString().slice(0,10));$('#to').val(n.toISOString().slice(0,10));IHMS.post('HelpdeskPerformance.aspx/Masters',{},function(d){$('#type').html('<option value="">All</option>'+d[0].map(x=>'<option value="'+x.RequestTypeID+'">'+IHMS.esc(x.Name)+'</option>').join(''));$('#priority').html('<option value="">All</option>'+d[2].map(x=>'<option value="'+x.PriorityCode+'">'+IHMS.esc(x.PriorityName)+'</option>').join(''));load()})}function load(){IHMS.post('HelpdeskPerformance.aspx/Get',{from:$('#from').val(),to:$('#to').val(),employeeId:$('#employee').val()?+$('#employee').val():null,requestTypeId:$('#type').val()?+$('#type').val():null,priority:$('#priority').val()},function(r){IHMS.table('#grid',r,[['Employee','EmployeeID'],['Assigned','Assigned'],['Open','Open'],['Resolved','Resolved'],['Closed','Closed'],['Overdue','Overdue'],['Reopened','Reopened'],['Avg first response (min)','AvgFirstResponseMinutes'],['Avg resolution (min)','AvgResolutionMinutes'],['SLA met','SLAMet'],['SLA missed','SLAMissed'],['SLA %','SLAPercent']]);if(chart)chart.destroy();chart=new Chart(document.getElementById('chart'),{type:'bar',data:{labels:r.map(x=>x.EmployeeID||'Unassigned'),datasets:[{label:'Open',data:r.map(x=>x.Open)},{label:'Resolved',data:r.map(x=>x.Resolved)},{label:'Closed',data:r.map(x=>x.Closed)}]}})})}$(boot);</script></asp:Content>
