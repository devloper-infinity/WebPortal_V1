<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssetReceipt.aspx.cs" Inherits="WebPortal.Assets.AssetReceipt" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Asset Receipt</h2><small>Assets / Asset Receipt</small></div><div class="erp-panel"><div class="erp-panel-title">Receipt Header</div><div class="erp-panel-body"><div class="row entry-form"><div class="hidden-id form-group"><label class="">ID</label><input id="rid" type="hidden" class="form-control" /></div><div class="col-md-3 form-group"><label class="required">Receipt Number</label><input id="rnumber" type="text" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Purchase Order</label><select id="po" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="required">Vendor</label><select id="vendor" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="required">Received Branch</label><select id="branch" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="required">Receipt Date</label><input id="rdate" type="date" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Invoice Number</label><input id="invoice" type="text" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Invoice Date</label><input id="invoiceDate" type="date" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Delivery Challan</label><input id="challan" type="text" class="form-control" /></div><div class="col-md-6 form-group"><label class="">Remarks</label><textarea id="remarks" class="form-control" rows="2"></textarea></div></div></div></div><div class="erp-panel"><div class="erp-panel-title">Received Items</div><div class="erp-panel-body"><table class="table table-bordered item-table"><thead><tr><th>PO Item ID</th><th>Ordered</th><th>Previously Received</th><th>Current Received</th><th>Rejected</th><th>Condition</th><th>Serial Numbers</th><th></th></tr></thead><tbody id="items"></tbody></table><button class="btn btn-outline-primary" onclick="addItem();return false;">Add Item</button> <button class="btn btn-primary" onclick="save();return false;">Save Receipt</button></div></div><div class="erp-panel"><div class="erp-panel-title">Receipts</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>var itemTemplate="<tr><td><input type=\"number\" class=\"form-control i-poitem\" /></td><td><input type=\"number\" class=\"form-control i-ordered\" /></td><td><input type=\"number\" class=\"form-control i-previous\" /></td><td><input type=\"number\" class=\"form-control i-current\" /></td><td><input type=\"number\" class=\"form-control i-rejected\" value=\"0\" /></td><td><input class=\"form-control i-condition\" value=\"Good\" /></td><td><textarea class=\"form-control i-serials\"></textarea></td><td><button class=\"btn btn-sm btn-danger\" onclick=\"$(this).closest('tr').remove();return false;\">Remove</button></td></tr>";function look(){[['PurchaseOrder','#po'],['Vendor','#vendor'],['Branch','#branch']].forEach(function(x){AssetUI.post('AssetReceipt.aspx/Lookup',{type:x[0],parentID:null},r=>AssetUI.fill(x[1],r,'ID','Name'));});}function addItem(){$('#items').append(itemTemplate);}function save(){var items=[];$('#items tr').each(function(){items.push({PurchaseOrderItemID:+$(this).find('.i-poitem').val()||null,OrderedQuantity:+$(this).find('.i-ordered').val(),PreviouslyReceivedQuantity:+$(this).find('.i-previous').val(),CurrentReceivedQuantity:+$(this).find('.i-current').val(),RejectedQuantity:+$(this).find('.i-rejected').val(),ConditionOnReceipt:$(this).find('.i-condition').val(),SerialNumbers:$(this).find('.i-serials').val()});});var x={ReceiptID:+$('#rid').val()||0,ReceiptNumber:$('#rnumber').val(),PurchaseOrderID:AssetUI.num('#po'),VendorID:+$('#vendor').val(),BranchID:+$('#branch').val(),ReceiptDate:$('#rdate').val(),InvoiceNumber:$('#invoice').val(),InvoiceDate:$('#invoiceDate').val()||null,DeliveryChallanNumber:$('#challan').val(),Remarks:$('#remarks').val(),Items:items};AssetUI.post('AssetReceipt.aspx/Save',{x:x},load);}function load(){AssetUI.post('AssetReceipt.aspx/List',{},r=>AssetUI.table('#grid',r,[{data:'ReceiptNumber',title:'Receipt No.'},{data:'ReceiptDate',title:'Date'},{data:'PurchaseOrderNumber',title:'PO No.'},{data:'VendorName',title:'Vendor'},{data:'BranchName',title:'Branch'},{data:'InvoiceNumber',title:'Invoice'},{data:'Status',title:'Status'}],[{text:'View',fn:'view',id:'ReceiptID'}]));}function view(id){location.href='AssetReceipt.aspx?id='+id;}$(function(){look();addItem();load();});</script></div><script src="asset-common.js"></script></asp:Content>