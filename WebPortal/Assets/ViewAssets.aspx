<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="ViewAssets.aspx.cs" Inherits="WebPortal.Assets.ViewAssets" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>View Assets</h2><small>Assets / View Assets</small></div><div class="erp-panel"><div class="erp-panel-title">Filters</div><div class="erp-panel-body"><div class="row"><div class="col-md-3 form-group"><label class="">Branch</label><select id="branch" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="">Status</label><select id="status" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="">Search</label><input id="search" type="text" class="form-control" /></div></div><button class="btn btn-primary" onclick="load();return false;">Search</button> <a class="btn btn-success" href="AddAsset.aspx">Add Asset</a></div></div><div class="erp-panel"><div class="erp-panel-title">Asset List</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>function look(){var branchName=AssetUI.query('branchName');AssetUI.post('ViewAssets.aspx/Lookup',{type:'Branch',parentID:null},function(rows){AssetUI.fill('#branch',rows,'ID','Name');if(branchName){$('#branch option').filter(function(){return $(this).text()===branchName;}).prop('selected',true);}load();});AssetUI.post('ViewAssets.aspx/Lookup',{type:'Status',parentID:null},r=>AssetUI.fill('#status',r,'ID','Name'));}function load(){var c=[{data:'AssetCode',title:'Asset Code'},{data:'AssetTagNumber',title:'Asset Tag'},{data:'SerialNumber',title:'Serial No.'},{data:'CategoryName',title:'Category'},{data:'AssetTypeName',title:'Type'},{data:'BrandName',title:'Brand'},{data:'ModelName',title:'Model'},{data:'BranchName',title:'Branch'},{data:'StatusName',title:'Status'},{data:'AssetCondition',title:'Condition'},{data:'PurchaseDate',title:'Purchase Date'}];AssetUI.post('ViewAssets.aspx/List',{branchID:AssetUI.num('#branch'),status:$('#status option:selected').text()==='-- Select --'?null:$('#status option:selected').text(),search:$('#search').val()},function(rows){var categoryName=AssetUI.query('categoryName');if(categoryName)rows=$.grep(rows||[],function(row){return row.CategoryName===categoryName;});AssetUI.table('#grid',rows,c,[{text:'View',fn:'viewAsset',id:'AssetID'},{text:'Edit',fn:'editAsset',id:'AssetID'}]);});}function viewAsset(id){location.href='AssetDetails.aspx?id='+id;}function editAsset(id){location.href='AddAsset.aspx?id='+id;}$(look);</script></div><script src="asset-common.js"></script></asp:Content>
