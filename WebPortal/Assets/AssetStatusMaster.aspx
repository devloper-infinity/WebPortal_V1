<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssetStatusMaster.aspx.cs" Inherits="WebPortal.Assets.AssetStatusMaster" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Asset Status Master</h2><small>Assets / Asset Status Master</small></div><div class="erp-panel"><div class="erp-panel-title">Master Details</div><div class="erp-panel-body"><div class="row entry-form"><div class="hidden-id form-group"><label class="">ID</label><input id="id" type="hidden" class="form-control" /></div><div class="col-md-3 form-group"><label class="required">Status Name</label><input id="name" type="text" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Status Code</label><input id="code" type="text" class="form-control" /></div><div class="col-md-6 form-group"><label class="">Description</label><textarea id="description" class="form-control" rows="2"></textarea></div><div class="col-md-3 form-group"><div><input id="alloc" type="checkbox" /> <span>Available for Allocation</span></div></div><div class="col-md-3 form-group"><div><input id="active" type="checkbox" /> <span>Active</span></div></div></div><button class="btn btn-primary" onclick="save();return false;">Save</button> <button class="btn btn-secondary" onclick="AssetUI.clear();return false;">Clear</button></div></div><div class="erp-panel"><div class="erp-panel-title">Existing Records</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>function load(){AssetUI.post('AssetStatusMaster.aspx/List',{},r=>AssetUI.table('#grid',r,[{data:'ID',title:'ID'},{data:'Name',title:'Name'},{data:'Code',title:'Code'},{data:'Description',title:'Description'},{data:'IsActive',title:'Active'}],[{text:'Edit',fn:'editRow',id:'ID'}]));}function save(){AssetUI.post('AssetStatusMaster.aspx/Save',{x:{ID:+$('#id').val()||0,Name:$('#name').val(),Code:$('#code').val(),Description:$('#description').val(),IsActive:$('#active').is(':checked'),Flag1:$('#alloc').is(':checked')}},function(){AssetUI.clear();load();});}function editRow(id){AssetUI.post('AssetStatusMaster.aspx/Get',{id:id},function(r){if(!r||!r.length)return;var x=r[0];$('#id').val(x.ID);$('#name').val(x.Name);$('#code').val(x.Code);$('#description').val(x.Description);$('#active').prop('checked',x.IsActive);});}$(function(){$('#active').prop('checked',true);load();});</script></div><script src="asset-common.js"></script></asp:Content>