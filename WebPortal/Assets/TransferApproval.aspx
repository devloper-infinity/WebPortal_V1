<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="TransferApproval.aspx.cs" Inherits="WebPortal.Assets.TransferApproval" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Transfer Approval</h2><small>Assets / Transfer Approval</small></div><div class="erp-panel"><div class="erp-panel-title">Requested Transfers</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>
function load(){AssetUI.post('TransferApproval.aspx/List',{},function(r){AssetUI.table('#grid',r,[{data:'TransferNumber',title:'Transfer No.'},{data:'AssetTagNumber',title:'Asset Tag'},{data:'FromBranchName',title:'From Branch'},{data:'ToBranchName',title:'To Branch'},{data:'TransferDate',title:'Transfer Date'},{data:'ExpectedReceiptDate',title:'Expected Receipt'},{data:'TransferReason',title:'Reason'},{data:'TransferStatus',title:'Status'}],[{text:'Approve',fn:'approve',id:'TransferID'},{text:'Reject',fn:'reject',id:'TransferID'}]);});}
function approve(id){act(id,'Approve','');}function reject(id){var r=prompt('Rejection reason');if(r!==null)act(id,'Reject',r);}function act(id,a,r){AssetUI.post('TransferApproval.aspx/Action',{id:id,action:a,remarks:r||''},load);}$(load);
</script></div><script src="asset-common.js"></script></asp:Content>
