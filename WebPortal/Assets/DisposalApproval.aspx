<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="DisposalApproval.aspx.cs" Inherits="WebPortal.Assets.DisposalApproval" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Disposal Approval</h2><small>Assets / Disposal Approval</small></div><div class="erp-panel"><div class="erp-panel-title">Pending Approvals</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>function load(){AssetUI.post('DisposalApproval.aspx/List',{status:'Pending'},function(r){var c=Object.keys(r[0]||{}).filter(x=>!x.endsWith('ID')||x==='AssetID').slice(0,9).map(x=>({data:x,title:x.replace(/([A-Z])/g,' $1')}));AssetUI.table('#grid',r,c,[{text:'Approve',fn:'approve',id:'DisposalID',cls:'btn-success'},{text:'Reject',fn:'reject',id:'DisposalID',cls:'btn-danger'}]);});}function approve(id){act(id,'Approve');}function reject(id){var r=prompt('Rejection reason');if(r!==null)act(id,'Reject',r);}function act(id,a,r){AssetUI.post('DisposalApproval.aspx/Action',{id:id,action:a,remarks:r||''},load);}$(load);</script></div><script src="asset-common.js"></script></asp:Content>
