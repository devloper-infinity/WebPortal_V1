<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="LocationWiseAssetReport.aspx.cs" Inherits="WebPortal.Assets.LocationWiseAssetReport" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Location-wise Asset Report</h2><small>Assets / Location-wise Asset Report</small></div><div class="erp-panel"><div class="erp-panel-title">Filters</div><div class="erp-panel-body"><div class="row"><div class="col-md-3 form-group"><label class="">Branch</label><select id="branch" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="">From Date</label><input id="from" type="date" class="form-control" /></div><div class="col-md-3 form-group"><label class="">To Date</label><input id="to" type="date" class="form-control" /></div></div><button class="btn btn-primary" onclick="load();return false;">Generate</button> <button class="btn btn-success" onclick="exportExcel();return false;">Export Excel</button></div></div><div class="erp-panel"><div class="erp-panel-title">Location-wise Asset Report</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>function look(){AssetUI.post('LocationWiseAssetReport.aspx/Lookup',{type:'Branch',parentID:null},r=>AssetUI.fill('#branch',r,'ID','Name'));}function load(){AssetUI.post('LocationWiseAssetReport.aspx/List',{branchID:AssetUI.num('#branch'),fromDate:$('#from').val()||null,toDate:$('#to').val()||null},r=>AssetUI.table('#grid',r,[{data:'BranchName',title:'Branch'},{data:'CategoryName',title:'Category'},{data:'TotalAssets',title:'Total'},{data:'AvailableAssets',title:'Available'},{data:'UnavailableAssets',title:'Unavailable'},{data:'PurchaseValue',title:'Purchase Value'}],[{text:'View Assets',fn:'view',id:'BranchName'}]));}function view(branch,row){location.href='ViewAssets.aspx?branchName='+encodeURIComponent(branch)+'&categoryName='+encodeURIComponent(row.CategoryName||'');}function exportExcel(){$('#grid').DataTable().button&&$('#grid').DataTable().button('.buttons-excel').trigger();}$(function(){look();load();});</script></div><script src="asset-common.js"></script></asp:Content>
