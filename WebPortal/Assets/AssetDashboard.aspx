<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssetDashboard.aspx.cs" Inherits="WebPortal.Assets.AssetDashboard" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Asset Dashboard</h2><small>Assets / Asset Dashboard</small></div><div class="row" id="cards"></div><div class="erp-panel"><div class="erp-panel-title">Assets by Status</div><div class="erp-panel-body"><div style="position:relative"><table id="statusGrid" class="table table-bordered table-sm"></table></div></div></div><div class="erp-panel"><div class="erp-panel-title">Recent Activity</div><div class="erp-panel-body"><div style="position:relative"><table id="activityGrid" class="table table-bordered table-sm"></table></div></div></div><script>function load(){AssetUI.post('AssetDashboard.aspx/Get',{},function(s){var h='';(s[0]||[]).forEach(function(x){h+='<div class="col-md-3"><div class="summary-card"><div>'+x.Title+'</div><div class="value">'+x.Value+'</div></div></div>';});$('#cards').html(h);AssetUI.table('#statusGrid',s[1]||[],[{data:'StatusName',title:'Status'},{data:'Total',title:'Total'}]);AssetUI.table('#activityGrid',s[2]||[],[{data:'ActivityType',title:'Activity'},{data:'ReferenceNumber',title:'Reference'},{data:'AssetTagNumber',title:'Asset Tag'},{data:'ActivityDate',title:'Date'},{data:'Status',title:'Status'}]);});}$(load);</script></div><script src="asset-common.js"></script></asp:Content>