<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="MasterReport.aspx.cs" Inherits="WebPortal.Assets.MasterReport" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /><style>#grid th{white-space:nowrap;vertical-align:middle;text-align:center}#grid td{white-space:nowrap}.report-group{background:#dce6f1!important;color:#17365d!important}</style></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Master Report</h2><small>Assets / Master Report</small></div>
<div class="erp-panel"><div class="erp-panel-title">Filters</div><div class="erp-panel-body"><div class="row"><div class="col-md-4 form-group"><label>Employee Search</label><input id="search" class="form-control" placeholder="Name, employee code or email" /></div></div><button class="btn btn-primary" onclick="load();return false;">Generate</button> <button class="btn btn-success" onclick="exportExcel();return false;">Export Excel</button></div></div>
<div class="erp-panel"><div class="erp-panel-title">Employee Hardware and Software Allocation</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div></div>
<script src="asset-common.js"></script><script>
var hardware=[['Laptop','Laptop'],['CPU','CPU'],['Monitor','Monitor'],['Keyboard','Keyboard'],['Mouse','Mouse'],['Headphone','Headphone']];
function appendValue(row,key,value){if(value==null||value==='')return;row[key]=row[key]?row[key]+', '+value:String(value);}
function hardwareGroup(type){var n=String(type||'').toLowerCase();for(var i=0;i<hardware.length;i++)if(n.indexOf(hardware[i][0].toLowerCase())>=0)return hardware[i][1];return null;}
function render(sets){var fields=sets[0]||[],employees=sets[1]||[],assets=sets[2]||[],values=sets[3]||[],rows={},valueMap={};employees.forEach(function(e){rows[e.EmployeeID]={UserName:e.UserName,EmployeeCode:e.EmployeeCode,PrimaryEmailID:e.PrimaryEmailID,Domain:e.Domain,WorkMode:'',Location:''};});values.forEach(function(v){if(!rows[v.EmployeeID])return;valueMap[v.EmployeeID+'|'+v.FieldCode]=v.FieldValue||'';});employees.forEach(function(e){var r=rows[e.EmployeeID],w=valueMap[e.EmployeeID+'|WORK_FROM_HOME']||'';r.WorkMode=/^yes$/i.test(w)?'WFH':(/^no$/i.test(w)?'WFO':w);r.Location=valueMap[e.EmployeeID+'|OFFICE_BRANCH']||'';fields.forEach(function(f){r[f.FieldCode]=valueMap[e.EmployeeID+'|'+f.FieldCode]||'';});});assets.forEach(function(a){var r=rows[a.EmployeeID],g=hardwareGroup(a.AssetTypeName);if(!r||!g)return;appendValue(r,g+'Name',a.BrandName||a.AssetTypeName);appendValue(r,g+'Serial',a.SerialNumber);appendValue(r,g+'Barcode',a.Barcode);});buildTable(employees.map(function(e){return rows[e.EmployeeID];}),fields);}
function buildTable(rows,fields){if($.fn.DataTable&&$.fn.DataTable.isDataTable('#grid'))$('#grid').DataTable().destroy();var core=[['UserName','User Name'],['EmployeeCode','Employee code'],['PrimaryEmailID','Primary email id'],['Domain','Domain'],['WorkMode','WFO/WFH'],['Location','Location']],cols=core.slice();hardware.forEach(function(h){cols.push([h[1]+'Name',h[0]],[h[1]+'Serial','Sr No'],[h[1]+'Barcode','Barcode']);});fields.forEach(function(f){cols.push([f.FieldCode,f.FieldLabel]);});var h='<thead><tr><th class="report-group" colspan="6">User details</th><th class="report-group" colspan="18">Hardware allocation</th><th class="report-group" colspan="'+Math.max(fields.length,1)+'">Software/apps allocation</th></tr><tr>';cols.forEach(function(c){h+='<th>'+AssetUI.escape(c[1])+'</th>';});h+='</tr></thead><tbody>';rows.forEach(function(r){h+='<tr>';cols.forEach(function(c){h+='<td>'+AssetUI.escape(r[c[0]]||'')+'</td>';});h+='</tr>';});$('#grid').html(h+'</tbody>');if($.fn.DataTable){var o={scrollX:true,responsive:false,pageLength:25,order:[],autoWidth:false};if($.fn.dataTable.Buttons){o.dom='Bfrtip';o.buttons=[{extend:'excelHtml5',className:'d-none',title:'Asset Master Report'}];}$('#grid').DataTable(o);}}
function load(){AssetUI.post('MasterReport.aspx/List',{search:$('#search').val()},render);}function exportExcel(){var t=$('#grid').DataTable();if(t.button)t.button('.buttons-excel').trigger();}$('#search').on('keypress',function(e){if(e.which===13){load();return false;}});$(load);
</script></asp:Content>
