<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssetDetails.aspx.cs" Inherits="WebPortal.Assets.AssetDetails" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Asset Details</h2><small>Assets / Asset Details</small></div><div class="erp-panel"><div class="erp-panel-title">Asset Details</div><div class="erp-panel-body"><div id="details"></div></div></div><div class="erp-panel"><div class="erp-panel-title">Allocation History</div><div class="erp-panel-body"><div style="position:relative"><table id="allocationGrid" class="table table-bordered table-sm"></table></div></div></div><div class="erp-panel"><div class="erp-panel-title">Transfer History</div><div class="erp-panel-body"><div style="position:relative"><table id="transferGrid" class="table table-bordered table-sm"></table></div></div></div><div class="erp-panel"><div class="erp-panel-title">Maintenance History</div><div class="erp-panel-body"><div style="position:relative"><table id="maintenanceGrid" class="table table-bordered table-sm"></table></div></div></div><script>function load(){var id=new URLSearchParams(location.search).get('id');AssetUI.post('AssetDetails.aspx/Get',{id:+id},function(s){var h=s[0]&&s[0][0]||{};var html='<div class="row">';Object.keys(h).forEach(function(k){html+='<div class="col-md-3 form-group"><label>'+k+'</label><div class="form-control">'+(h[k]||'')+'</div></div>';});$('#details').html(html+'</div>');if(s[1])AssetUI.table('#allocationGrid',s[1],[{data:'AllocationNumber',title:'Allocation No.'},{data:'AllocationDate',title:'Date'},{data:'EmployeeID',title:'Employee'},{data:'AllocationStatus',title:'Status'},{data:'ReturnDate',title:'Return Date'}]);if(s[2])AssetUI.table('#transferGrid',s[2],[{data:'TransferNumber',title:'Transfer No.'},{data:'TransferDate',title:'Date'},{data:'FromBranchName',title:'From'},{data:'ToBranchName',title:'To'},{data:'TransferStatus',title:'Status'}]);if(s[3])AssetUI.table('#maintenanceGrid',s[3],[{data:'RequestNumber',title:'Request No.'},{data:'ComplaintDate',title:'Complaint Date'},{data:'ProblemDescription',title:'Problem'},{data:'CurrentStatus',title:'Status'},{data:'TotalCost',title:'Cost'}]);});}$(load);</script></div><script src="asset-common.js"></script></asp:Content>