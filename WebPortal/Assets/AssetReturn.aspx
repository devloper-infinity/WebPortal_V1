<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssetReturn.aspx.cs" Inherits="WebPortal.Assets.AssetReturn" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Asset Return</h2><small>Assets / Asset Return</small></div><div class="erp-panel"><div class="erp-panel-title">Return Asset</div><div class="erp-panel-body"><div class="row entry-form"><div class="col-md-3 form-group"><label class="required">Active Allocation</label><select id="allocation" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="required">Return Date</label><input id="returnDate" type="date" class="form-control" /></div><div class="col-md-3 form-group"><label class="required">Return Branch</label><select id="returnBranch" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="">Condition at Return</label><select id="condition" class="form-control"><option value="">-- Select --</option><option value="Good">Good</option><option value="Fair">Fair</option><option value="Damaged">Damaged</option></select></div><div class="col-md-3 form-group"><label class="">Next Asset Status</label><select id="nextStatus" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="">Recovery Amount</label><input id="recovery" type="number" class="form-control" /></div><div class="col-md-6 form-group"><label class="">Accessories Returned</label><textarea id="accessories" class="form-control" rows="2"></textarea></div><div class="col-md-6 form-group"><label class="">Missing Accessories</label><textarea id="missing" class="form-control" rows="2"></textarea></div><div class="col-md-6 form-group"><label class="">Damage Details</label><textarea id="damage" class="form-control" rows="2"></textarea></div><div class="col-md-6 form-group"><label class="">Remarks</label><textarea id="remarks" class="form-control" rows="2"></textarea></div></div><button class="btn btn-primary" onclick="save();return false;">Complete Return</button></div></div><div class="erp-panel"><div class="erp-panel-title">Recent Returns</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>function look(){var selectedId=AssetUI.query('id');[['ActiveAllocation','#allocation'],['Branch','#returnBranch'],['Status','#nextStatus']].forEach(function(x){AssetUI.post('AssetReturn.aspx/Lookup',{type:x[0],parentID:null},function(rows){AssetUI.fill(x[1],rows,'ID','Name');if(x[0]==='ActiveAllocation'&&selectedId)$(x[1]).val(selectedId);});});}function save(){var x={AllocationID:+$('#allocation').val(),ReturnDate:$('#returnDate').val(),ConditionAtReturn:$('#condition').val(),AccessoriesReturned:$('#accessories').val(),MissingAccessories:$('#missing').val(),DamageDetails:$('#damage').val(),ReturnBranchID:+$('#returnBranch').val(),NextStatusID:AssetUI.num('#nextStatus'),RecoveryAmount:+$('#recovery').val()||0,Remarks:$('#remarks').val()};AssetUI.post('AssetReturn.aspx/Save',{x:x},load);}function load(){AssetUI.post('AssetReturn.aspx/List',{},r=>AssetUI.table('#grid',r,[{data:'AllocationNumber',title:'Allocation No.'},{data:'AssetTagNumber',title:'Asset Tag'},{data:'EmployeeID',title:'Employee'},{data:'ReturnDate',title:'Return Date'},{data:'ConditionAtReturn',title:'Condition'},{data:'RecoveryAmount',title:'Recovery'},{data:'Status',title:'Status'}],[{text:'View Asset',fn:'viewAsset',id:'AssetID'}]));}function viewAsset(id){location.href='AssetDetails.aspx?id='+id;}$(function(){look();load();});</script></div><script src="asset-common.js"></script></asp:Content>
