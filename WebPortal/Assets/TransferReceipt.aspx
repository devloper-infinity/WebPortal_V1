<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="TransferReceipt.aspx.cs" Inherits="WebPortal.Assets.TransferReceipt" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Transfer Receipt</h2><small>Assets / Transfer Receipt</small></div><div class="erp-panel"><div class="erp-panel-title">Transfers Awaiting Receipt</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>function load(){AssetUI.post('TransferReceipt.aspx/List',{},r=>AssetUI.table('#grid',r,[{data:'TransferNumber',title:'Transfer No.'},{data:'AssetTagNumber',title:'Asset Tag'},{data:'FromBranchName',title:'From'},{data:'ToBranchName',title:'To'},{data:'DispatchDate',title:'Dispatch Date'},{data:'CourierName',title:'Courier'},{data:'TrackingNumber',title:'Tracking No.'},{data:'TransferStatus',title:'Status'}],[{text:'Receive',fn:'receive',id:'TransferID',cls:'btn-success'},{text:'Reject',fn:'reject',id:'TransferID',cls:'btn-danger'}]));}function receive(id){var c=prompt('Condition on receipt','Good');if(c!==null)AssetUI.post('TransferReceipt.aspx/Action',{id:id,action:'Received',remarks:c},load);}function reject(id){var r=prompt('Rejection reason');if(r!==null)AssetUI.post('TransferReceipt.aspx/Action',{id:id,action:'Rejected',remarks:r},load);}$(load);</script></div><script src="asset-common.js"></script></asp:Content>