<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssetDisposal.aspx.cs" Inherits="WebPortal.Assets.AssetDisposal" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Asset Disposal</h2><small>Assets / Asset Disposal</small></div><div class="erp-panel"><div class="erp-panel-title">Asset Disposal Request</div><div class="erp-panel-body"><div class="row entry-form"><div class="hidden-id form-group"><label class="">ID</label><input id="did" type="hidden" class="form-control" /></div><div class="col-md-3 form-group"><label class="required">Asset</label><select id="asset" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="required">Request Date</label><input id="date" type="date" class="form-control" /></div><div class="col-md-3 form-group"><label class="required">Disposal Reason</label><select id="reason" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="required">Disposal Method</label><select id="method" class="form-control"><option value="">-- Select --</option><option value="Sold">Sold</option><option value="Scrapped">Scrapped</option><option value="Donated">Donated</option><option value="Written Off">Written Off</option><option value="Returned to Vendor">Returned to Vendor</option></select></div><div class="col-md-3 form-group"><label class="">Current Book Value</label><input id="bookValue" type="number" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Sale Value</label><input id="saleValue" type="number" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Buyer Name</label><input id="buyer" type="text" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Scrap Vendor</label><input id="scrapVendor" type="text" class="form-control" /></div><div class="col-md-6 form-group"><label class="">Remarks</label><textarea id="remarks" class="form-control" rows="2"></textarea></div></div><button class="btn btn-primary" onclick="save();return false;">Submit Disposal Request</button></div></div><div class="erp-panel"><div class="erp-panel-title">Disposal Requests</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>function look(){AssetUI.post('AssetDisposal.aspx/Lookup',{type:'Asset',parentID:null},r=>AssetUI.fill('#asset',r,'ID','Name'));AssetUI.post('AssetDisposal.aspx/Lookup',{type:'DisposalReason',parentID:null},r=>AssetUI.fill('#reason',r,'ID','Name'));}function save(){var x={DisposalID:+$('#did').val()||0,AssetID:+$('#asset').val(),DisposalRequestDate:$('#date').val(),DisposalReasonID:+$('#reason').val(),ProposedDisposalMethod:$('#method').val(),CurrentBookValue:+$('#bookValue').val()||0,SaleValue:+$('#saleValue').val()||0,BuyerName:$('#buyer').val(),ScrapVendor:$('#scrapVendor').val(),Remarks:$('#remarks').val()};AssetUI.post('AssetDisposal.aspx/Save',{x:x},load);}function load(){AssetUI.post('AssetDisposal.aspx/List',{},r=>AssetUI.table('#grid',r,[{data:'DisposalNumber',title:'Disposal No.'},{data:'AssetTagNumber',title:'Asset Tag'},{data:'ReasonName',title:'Reason'},{data:'ProposedDisposalMethod',title:'Method'},{data:'CurrentBookValue',title:'Book Value'},{data:'SaleValue',title:'Sale Value'},{data:'ApprovalStatus',title:'Approval'},{data:'Status',title:'Status'}],[{text:'View Asset',fn:'view',id:'AssetID'},{text:'Edit',fn:'edit',id:'DisposalID'}]));}function view(id){location.href='AssetDetails.aspx?id='+id;}function edit(id){location.href='AssetDisposal.aspx?id='+id;}$(function(){look();load();});</script></div><script src="asset-common.js"></script></asp:Content>