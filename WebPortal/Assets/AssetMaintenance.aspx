<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssetMaintenance.aspx.cs" Inherits="WebPortal.Assets.AssetMaintenance" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Asset Maintenance</h2><small>Assets / Asset Maintenance</small></div><div class="erp-panel"><div class="erp-panel-title">Maintenance Request</div><div class="erp-panel-body"><div class="row entry-form"><div class="hidden-id form-group"><label class="">ID</label><input id="mid" type="hidden" class="form-control" /></div><div class="col-md-3 form-group"><label class="required">Asset</label><select id="asset" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="required">Complaint Date</label><input id="date" type="date" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Priority</label><select id="priority" class="form-control"><option value="">-- Select --</option><option value="Low">Low</option><option value="Normal">Normal</option><option value="High">High</option><option value="Critical">Critical</option></select></div><div class="col-md-3 form-group"><label class="">Assigned To Employee ID</label><input id="assigned" type="number" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Repair Vendor</label><select id="vendor" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="">Expected Completion</label><input id="expected" type="date" class="form-control" /></div><div class="col-md-6 form-group"><label class="required">Problem Description</label><textarea id="problem" class="form-control" rows="2"></textarea></div><div class="col-md-6 form-group"><label class="">Diagnosis</label><textarea id="diagnosis" class="form-control" rows="2"></textarea></div><div class="col-md-6 form-group"><label class="">Repair Action</label><textarea id="action" class="form-control" rows="2"></textarea></div><div class="col-md-6 form-group"><label class="">Parts Replaced</label><textarea id="parts" class="form-control" rows="2"></textarea></div><div class="col-md-3 form-group"><label class="">Repair Cost</label><input id="repairCost" type="number" class="form-control" /></div><div class="col-md-3 form-group"><label class="">Service Charge</label><input id="serviceCharge" type="number" class="form-control" /></div><div class="col-md-3 form-group"><div><input id="warranty" type="checkbox" /> <span>Warranty Claimed</span></div></div><div class="col-md-6 form-group"><label class="">Remarks</label><textarea id="remarks" class="form-control" rows="2"></textarea></div></div><button class="btn btn-primary" onclick="save();return false;">Save Maintenance</button></div></div><div class="erp-panel"><div class="erp-panel-title">Open Maintenance</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>function look(){AssetUI.post('AssetMaintenance.aspx/Lookup',{type:'Asset',parentID:null},r=>AssetUI.fill('#asset',r,'ID','Name'));AssetUI.post('AssetMaintenance.aspx/Lookup',{type:'Vendor',parentID:null},r=>AssetUI.fill('#vendor',r,'ID','Name'));}function save(){var x={MaintenanceID:+$('#mid').val()||0,AssetID:+$('#asset').val(),ComplaintDate:$('#date').val(),ProblemDescription:$('#problem').val(),Priority:$('#priority').val(),AssignedTo:AssetUI.num('#assigned'),VendorID:AssetUI.num('#vendor'),ExpectedCompletionDate:$('#expected').val()||null,Diagnosis:$('#diagnosis').val(),RepairAction:$('#action').val(),PartsReplaced:$('#parts').val(),RepairCost:+$('#repairCost').val()||0,ServiceCharge:+$('#serviceCharge').val()||0,WarrantyClaimed:$('#warranty').is(':checked'),Remarks:$('#remarks').val()};AssetUI.post('AssetMaintenance.aspx/Save',{x:x},load);}function load(){AssetUI.post('AssetMaintenance.aspx/List',{},r=>AssetUI.table('#grid',r,[{data:'RequestNumber',title:'Request No.'},{data:'AssetTagNumber',title:'Asset Tag'},{data:'ComplaintDate',title:'Complaint Date'},{data:'ProblemDescription',title:'Problem'},{data:'Priority',title:'Priority'},{data:'VendorName',title:'Vendor'},{data:'CurrentStatus',title:'Status'},{data:'TotalCost',title:'Total Cost'}],[{text:'Edit',fn:'edit',id:'MaintenanceID'},{text:'Complete',fn:'complete',id:'MaintenanceID',cls:'btn-success'}]));}function edit(id){location.href='AssetMaintenance.aspx?id='+id;}function complete(id){var r=prompt('Completion remarks');if(r!==null)AssetUI.post('AssetMaintenance.aspx/Action',{id:id,action:'Completed',remarks:r},load);}$(function(){look();load();});</script></div><script src="asset-common.js"></script></asp:Content>