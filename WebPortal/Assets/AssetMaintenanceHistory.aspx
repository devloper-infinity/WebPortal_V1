<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssetMaintenanceHistory.aspx.cs" Inherits="WebPortal.Assets.AssetMaintenanceHistory" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Asset Maintenance History</h2><small>Assets / Asset Maintenance History</small></div><div class="erp-panel"><div class="erp-panel-title">Filters</div><div class="erp-panel-body"><div class="row"><div class="col-md-3 form-group"><label class="">Branch</label><select id="branch" class="form-control"><option value="">-- Select --</option></select></div><div class="col-md-3 form-group"><label class="">From Date</label><input id="from" type="date" class="form-control" /></div><div class="col-md-3 form-group"><label class="">To Date</label><input id="to" type="date" class="form-control" /></div></div><button class="btn btn-primary" onclick="load();return false;">Search</button></div></div><div class="erp-panel"><div class="erp-panel-title">Maintenance History</div><div class="erp-panel-body"><div style="position:relative"><table id="grid" class="table table-bordered table-sm"></table></div></div></div><script>function look(){AssetUI.post('AssetMaintenanceHistory.aspx/Lookup',{type:'Branch',parentID:null},r=>AssetUI.fill('#branch',r,'ID','Name'));}function load(){AssetUI.post('AssetMaintenanceHistory.aspx/List',{branchID:AssetUI.num('#branch'),fromDate:$('#from').val()||null,toDate:$('#to').val()||null},r=>AssetUI.table('#grid',r,[{data:'RequestNumber',title:'Request No.'},{data:'AssetTagNumber',title:'Asset Tag'},{data:'BranchName',title:'Branch'},{data:'ComplaintDate',title:'Complaint Date'},{data:'CompletedDate',title:'Completed Date'},{data:'ProblemDescription',title:'Problem'},{data:'RepairAction',title:'Repair Action'},{data:'VendorName',title:'Vendor'},{data:'TotalCost',title:'Cost'},{data:'CurrentStatus',title:'Status'}],[{text:'View Asset',fn:'view',id:'AssetID'}]));}function view(id){location.href='AssetDetails.aspx?id='+id;}$(function(){look();load();});</script></div><script src="asset-common.js"></script></asp:Content>