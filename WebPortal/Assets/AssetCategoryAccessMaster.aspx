<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssetCategoryAccessMaster.aspx.cs" Inherits="WebPortal.Assets.AssetCategoryAccessMaster" MasterPageFile="~/Assets/Admin.Master" %>
<asp:Content ID="HeadContent" ContentPlaceHolderID="head" runat="server"><link href="asset-common.css" rel="stylesheet" /><style>.category-access-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}.category-access-item{border:1px solid #dbe5f3;border-radius:10px;padding:14px;background:#fff;cursor:pointer}.category-access-item:hover{border-color:#2b78e4;background:#f6faff}.category-access-item input{margin-right:9px}.access-note{color:#64748b;font-size:12px;margin-top:6px}</style></asp:Content>
<asp:Content ID="MainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="asset-page"><div class="asset-hero"><h2>Asset Category Access</h2><small>Assets / Masters / User Category Access</small></div><div class="erp-panel"><div class="erp-panel-title"><i class="fas fa-user-shield"></i> User Access Profile</div><div class="erp-panel-body"><div class="row"><div class="col-md-6 form-group"><label class="required">Employee / User</label><select id="user" class="form-control"><option value="">-- Select Employee --</option></select><div class="access-note">Once saved, this employee will only see records belonging to the selected categories.</div></div></div><div class="mb-3"><button class="btn btn-sm btn-outline-primary" onclick="toggleAll(true);return false;"><i class="fas fa-check-double"></i> Select All</button> <button class="btn btn-sm btn-outline-secondary" onclick="toggleAll(false);return false;"><i class="fas fa-times"></i> Clear All</button></div><div id="categories" class="category-access-list"><div class="text-muted">Select an employee to configure access.</div></div><div class="mt-4"><button class="btn btn-primary" onclick="saveAccess();return false;"><i class="fas fa-save"></i> Save Category Access</button></div></div></div><div class="erp-panel"><div class="erp-panel-title"><i class="fas fa-info-circle"></i> Access Rule</div><div class="erp-panel-body">Category access is enforced on inventory, allocation, return, transfer, maintenance, disposal, procurement, approvals, dashboards, reports, detail pages and lookup lists. Employees without a configured profile retain existing full visibility until their first profile is saved.</div></div></div><script>function loadUsers(){AssetUI.post('AssetCategoryAccessMaster.aspx/Users',{},function(rows){var s=$('#user').empty().append('<option value="">-- Select Employee --</option>');(rows||[]).forEach(function(x){s.append($('<option>').val(x.EmployeeID).text(x.EmployeeName+' ['+x.DepartmentName+']'));});});}function loadCategories(){var user=+$('#user').val();if(!user){$('#categories').html('<div class="text-muted">Select an employee to configure access.</div>');return;}AssetUI.post('AssetCategoryAccessMaster.aspx/Get',{userID:user},function(rows){var h='';(rows||[]).forEach(function(x){h+='<label class="category-access-item"><input type="checkbox" class="category-check" value="'+x.AssetCategoryID+'" '+(x.Selected?'checked':'')+'><strong>'+AssetUI.escape(x.CategoryName)+'</strong><div class="access-note">'+AssetUI.escape(x.CategoryCode||'')+'</div></label>';});$('#categories').html(h||'<div class="text-muted">No active asset categories found.</div>');});}function toggleAll(value){$('.category-check').prop('checked',value);}function saveAccess(){var user=+$('#user').val();if(!user){AssetUI.message('Please select an employee.','error');return;}var ids=$('.category-check:checked').map(function(){return +this.value;}).get();AssetUI.post('AssetCategoryAccessMaster.aspx/Save',{input:{UserID:user,CategoryIDs:ids}},function(){AssetUI.message('Category access saved successfully.','success');loadCategories();});}$(function(){loadUsers();$('#user').on('change',loadCategories);});</script><script src="asset-common.js"></script></asp:Content>
