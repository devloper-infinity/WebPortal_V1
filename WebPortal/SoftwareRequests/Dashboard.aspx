<%@ Page Title="Software Request Tracker" Language="C#" MasterPageFile="~/IT/Admin.Master" AutoEventWireup="true" CodeBehind="Dashboard.aspx.cs" Inherits="WebPortal.SoftwareRequests.Dashboard" %>
<asp:Content ID="H" ContentPlaceHolderID="head" runat="server"><link href="../Content/software-requests.css?v=12" rel="stylesheet" /></asp:Content>
<asp:Content ID="B" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="srm"><div class="srm-head"><div><h3>Software Request &amp; Task Tracker</h3><span>Request visibility, software queue and delivery timeline</span></div><button type="button" class="srm-btn" onclick="SRM.show('new')"><i class="fas fa-plus"></i> New Request</button></div><div id="srmAlert" class="srm-alert"></div>
<div class="srm-grid"><div class="srm-kpi k-new">New<b data-kpi="NewCount">0</b></div><div class="srm-kpi k-progress">In Progress<b data-kpi="InProgressCount">0</b></div><div class="srm-kpi k-hold">On Hold<b data-kpi="OnHoldCount">0</b></div><div class="srm-kpi k-test">Testing<b data-kpi="TestingCount">0</b></div><div class="srm-kpi k-done">Completed<b data-kpi="CompletedCount">0</b></div></div>
<div class="srm-tabs"><button type="button" data-view="list" class="active">Current Tasks</button><button type="button" data-view="completed">Completed Tasks</button><button type="button" data-view="new">New Request</button><button type="button" data-view="detail">Request Detail</button><button type="button" class="developer-only" data-view="activity" onclick="SRM.loadActivities()">Hourly Activity</button><button type="button" data-view="report" onclick="SRM.loadUtilization()">Developer Report</button><button type="button" class="management-only" data-view="priority-report" onclick="SRM.loadPriorityReport()">Priority Impact</button></div>
<section id="view-list" class="srm-view"><div class="srm-card"><div class="srm-list-toolbar"><div><label>View / Group By</label><select id="fGroup" onchange="SRM.renderList()"><option value="">Flat Task List</option><option value="ModuleName">Module</option><option value="TaskOwnerName">Task Owner</option><option value="Priority">Priority</option><option value="AssignedDeveloperName">Assigned To</option></select></div><div class="srm-view-hint">Choose how the queue should be organized.</div></div><div class="srm-filters"><select id="fScope"><option value="Mine">My Requests</option><option value="All">All Requests / Queue</option></select><input id="fSearch" placeholder="Request ID or title"/><input id="fRequester" placeholder="Requester"/><input id="fDepartment" placeholder="Department"/><select id="fApplication"></select><select id="fModule"></select><select id="fDeveloper"></select><select id="fPriority"></select><select id="fStatus"></select><button type="button" class="srm-btn" onclick="SRM.loadList()">Search</button><button type="button" class="srm-btn alt" onclick="SRM.exportCsv()">Export Excel</button></div><div class="srm-table-wrap"><table id="requestTable" class="srm-table"><thead><tr><th>Request ID</th><th>Date</th><th>Request</th><th>Software</th><th>Module</th><th>Task Owner</th><th>Priority</th><th>Assigned To</th><th>Status</th><th>Expected Completion</th><th>Last Update</th></tr></thead><tbody id="requestRows"></tbody></table></div></div></section>
<section id="view-new" class="srm-view srm-hidden"><div class="srm-card compact"><h4>New Software Request</h4><div class="srm-profile"><b id="profileName"></b><span id="profileDepartment"></span></div><div class="srm-form"><div><label>Request Type *</label><select id="rqType"></select></div><div><label>Requested Priority *</label><select id="rqPriority"></select></div><div><label>Software / Application *</label><select id="rqApp"></select></div><div><label>Module</label><select id="rqModule"></select></div><div class="wide"><label>Title *</label><input id="rqTitle" maxlength="250"/></div><div class="wide"><label>Requirement / Description *</label><textarea id="rqDescription"></textarea></div><div class="wide"><label>Business Justification *</label><textarea id="rqJustification"></textarea></div><div><label>Required By Date</label><input id="rqDate" type="date"/></div><div><label>Attachment (optional, max 5 MB)</label><input id="rqAttachment" type="file" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx"/></div></div><button type="button" class="srm-btn" onclick="SRM.create()">Submit Request</button></div></section>
<section id="view-activity" class="srm-view srm-hidden"><div class="srm-card"><h4>Developer Hourly Activity</h4><input type="hidden" id="aID" value="0"/><div class="srm-form"><div><label>Activity Type *</label><select id="aType"><option>Meeting</option><option>Call/Discussion</option><option>Technical Help/Support</option><option>Technical Email/Documentation</option><option>Investigation/R&amp;D</option><option>Other</option></select></div><div><label>Task / Activity Owner *</label><select id="aOwner"></select></div><div class="wide"><label>Description *</label><textarea id="aDescription"></textarea></div><div><label>Activity Date *</label><input id="aDate" type="date"/></div><div><label>Start Time *</label><input id="aStart" type="time"/></div><div><label>End Time *</label><input id="aEnd" type="time"/></div><div><label>Total Duration</label><input id="aDuration" readonly/></div><div class="wide"><label>Remarks</label><textarea id="aRemarks"></textarea></div><div class="wide"><label>Testing Email ID (optional)</label><input id="aTestEmail" type="email" placeholder="Redirect creation email during testing"/></div></div><button type="button" class="srm-btn" onclick="SRM.saveActivity()">Save Activity</button><button type="button" class="srm-btn alt" onclick="SRM.clearActivity()">Clear</button></div><div class="srm-card"><div class="srm-filters"><input id="aFrom" type="date"/><input id="aTo" type="date"/><button type="button" class="srm-btn" onclick="SRM.loadActivities()">View Activities</button></div><div class="srm-table-wrap"><table class="srm-table"><thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Owner</th><th>Start</th><th>End</th><th>Duration</th><th>Remarks</th><th></th></tr></thead><tbody id="activityRows"></tbody></table></div></div></section>
<section id="view-report" class="srm-view srm-hidden"><div class="srm-card"><h4>Developer Other Activity Report</h4><div class="srm-filters"><select id="rDeveloper"></select><div><label>From Date</label><input id="rFrom" type="date"/></div><div><label>To Date</label><input id="rTo" type="date"/></div><button type="button" class="srm-btn" onclick="SRM.loadUtilization()">View Report</button><button type="button" class="srm-btn alt" onclick="SRM.exportUtilization()">Export to Excel</button></div><div class="srm-table-wrap"><table id="utilSummary" class="srm-table"><thead><tr><th>Developer</th><th>Other Activity Hours</th></tr></thead><tbody id="utilSummaryRows"></tbody></table></div></div><div class="srm-card"><h4>Where Other Activity Hours Were Utilised</h4><div class="srm-table-wrap"><table id="utilDetails" class="srm-table"><thead><tr><th>Date</th><th>Developer</th><th>Activity Type</th><th>Owner</th><th>Description</th><th>Duration</th><th>Total Daily Hours</th></tr></thead><tbody id="utilDetailRows"></tbody></table></div></div><div class="srm-card"><h4>Developer Availability / Allocation</h4><div class="srm-table-wrap"><table id="developerAvailability" class="srm-table"><thead><tr><th>Developer</th><th>Availability</th><th>Allocated Through</th><th>Active Tasks</th><th>Current Priority Task</th><th>Status</th><th>Priority</th></tr></thead><tbody id="availabilityRows"></tbody></table></div></div></section>
<section id="view-priority-report" class="srm-view srm-hidden"><div class="srm-grid"><div class="srm-kpi">Priority Changes<b id="pcCount">0</b></div><div class="srm-kpi">Impacted Tasks<b id="piCount">0</b></div><div class="srm-kpi">Delay Days<b id="pdCount">0</b></div><div class="srm-kpi">Management Overrides<b id="poCount">0</b></div></div><div class="srm-card"><h4>Priority Change Impact Report</h4><div class="srm-table-wrap"><table class="srm-table"><thead><tr><th>Caused By</th><th>Impacted Task</th><th>Title</th><th>Developer</th><th>Previous ETA</th><th>Revised ETA</th><th>Delay Days</th><th>Priority Change</th><th>Override</th><th>Reason</th></tr></thead><tbody id="priorityReportRows"></tbody></table></div></div></section>
<section id="view-detail" class="srm-view srm-hidden"><div class="srm-card"><div class="srm-detail-head"><div><h4 id="dTitle">Select a request</h4><div id="dMeta"></div></div><div><button type="button" class="srm-btn alt" onclick="SRM.priorityHistory()">Priority History</button> <button type="button" class="srm-btn alt" onclick="SRM.show('list')">Back</button></div></div><div id="dPriorityInfo" class="srm-profile"></div><div class="srm-detail-grid"><div><label>Description</label><p id="dDescription"></p></div><div><label>Business Justification</label><p id="dJustification"></p></div><div><label>Latest Update</label><p id="dUpdate"></p></div><div><label>Timeline</label><p id="dTimeline"></p></div></div></div>
<div id="teamPanel" class="srm-card srm-hidden"><h4>Software Team Update</h4><div class="srm-form"><div><label>Assigned Developer</label><select id="uDeveloper"></select></div><div><label>Status</label><select id="uStatus"></select></div><div><label>Expected Start</label><input id="uStart" type="date"/></div><div><label>Expected Completion</label><input id="uCompletion" type="date"/></div><div class="wide"><label>Developer Remarks / Latest Update</label><textarea id="uUpdate"></textarea></div><div class="wide" id="holdBox"><label>On Hold Reason</label><input id="uHold" maxlength="500"/></div><div class="wide"><label>Testing email override (optional)</label><input id="uTestEmail" type="email" placeholder="Send only to this address during testing"/></div></div><button type="button" class="srm-btn" onclick="SRM.update()">Save Task Update</button></div>
<div id="priorityPanel" class="srm-card srm-hidden"><div class="srm-detail-head"><h4>Priority Approval / Change</h4><button type="button" class="srm-btn alt" onclick="SRM.priorityHistory()">Priority History</button></div><div id="prioritySummary" class="srm-profile"></div><div class="srm-form"><div><label>New Approved Priority *</label><select id="pPriority"></select></div><div><label>Revised ETA</label><input id="pETA" type="date"/></div><div class="wide"><label>Mandatory Change Reason *</label><textarea id="pReason"></textarea></div><div class="management-only"><label><input id="pOverride" type="checkbox" style="width:auto"/> Management Override</label></div><div class="management-only"><label>Testing Email ID</label><input id="pTestEmail" type="email"/></div></div><button type="button" class="srm-btn developer-only priority-request" onclick="SRM.requestPriority()">Request Priority Change</button><button type="button" class="srm-btn management-only" onclick="SRM.approvePriority()">Preview &amp; Approve Priority</button><div id="priorityHistoryBox" class="srm-hidden"><div class="srm-table-wrap"><table class="srm-table"><thead><tr><th>Date</th><th>Old</th><th>New</th><th>Changed By</th><th>Reason</th><th>ETA Impact</th><th>Override</th></tr></thead><tbody id="priorityHistoryRows"></tbody></table></div></div></div>
<div class="srm-card"><h4>Updates Till Date</h4><div class="srm-table-wrap"><table class="srm-table srm-history-table"><thead><tr><th>Date</th><th>Assigned Developer</th><th>Status</th><th>Expected Completion Date</th><th>Developer Remark</th><th>Hold Reason</th></tr></thead><tbody id="historyRows"></tbody></table></div></div></section></div>
<script src="../Scripts/software-requests.js?v=17"></script>
</asp:Content>
