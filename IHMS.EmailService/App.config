<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>
  <connectionStrings>
    <add name="MainCon" connectionString="Data Source=23.111.175.186;Initial Catalog=InfinityERP;Persist Security Info=True;User ID=sa;Password=#Cl0ud^$ecure4; Pooling=true; Min Pool Size=1; Max Pool Size=10; Connect Timeout=200; Packet Size=8192" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <!-- Workload switches. Set IT to false to run only Underwriting billing reminders. -->
    <add key="EnableITEmailService" value="false"/>
    <add key="EnableUnderwritingBillingService" value="false"/>
    <add key="EnableCommitmentBillingService" value="false"/>
    <!-- Client auto billing is separately disabled until SQL deployment and recipient verification are complete. -->
    <add key="EnableCommitmentClientAutoBillingService" value="false"/>
    <add key="EnableValuationClientAutoBillingService" value="false"/>
    <add key="EnableUnderwritingClientBillingService" value="false"/>
    <add key="TenantId" value="8650f772-f170-404a-81be-061db6e97f93"/>
    <add key="ClientId" value="701da8ac-2292-497f-9aeb-ee10c9e9a136"/>
    <add key="ClientSecret" value="sKC8Q~7_M5m6J.K1G7qBh71VxggFdJICJ3Q8Uc2k"/>
    <add key="SharedMailbox" value="ITSupport@infinity-data.com"/>
    <add key="BillingReminderMailbox" value="ack@infinity-data.com"/>
    <!-- Separate multiple production CC/BCC addresses with semicolons or commas. Leave blank when unused. -->
    <add key="BillingReminderCc" value="s.chandrakant@infinity-data.com"/>
    <add key="BillingReminderBcc" value="n.nilkanth@infinity-data.com"/>
    <add key="PollSeconds" value="30"/>
    <add key="AttachmentRoot" value="C:\IHMS\Attachments"/>
    <!-- TestMode=true prevents delivery to original recipients. If TestRecipient is blank, all outbound mail is suppressed. -->
    <add key="TestMode" value="true"/>
    <add key="TestRecipient" value="n.nilkanth@infinity-data.com"/>
    <!-- Underwriting billing reminders have an independent safety switch. Production To/CC/BCC recipients never receive these while test mode is enabled. -->
    <add key="BillingReminderTestMode" value="false"/>
    <add key="BillingReminderTestEmail" value="n.nilkanth@infinity-data.com"/>
    <!-- Commitment reminders use an independent test redirect and recipient list. -->
    <add key="CommitmentBillingReminderTestMode" value="true"/>
    <add key="CommitmentBillingReminderTestEmail" value="n.nilkanth@infinity-data.com"/>
    <add key="CommitmentBillingReminderCc" value="prashant.patil@infinity-data.com"/>
    <add key="CommitmentBillingReminderBcc" value="n.nilkanth@infinity-data.com"/>
    <!-- Commitment client billing runs at this hour on the 16th and 2nd. Test Mode suppresses configured client TO/CC/BCC. -->
    <add key="CommitmentClientBillingRunHour" value="7"/>
    <!-- Set true only for a controlled manual run outside the 2nd/16th schedule, then immediately return it to false. -->
    <add key="CommitmentClientBillingForceRun" value="false"/>
    <add key="CommitmentClientBillingTestMode" value="false"/>
    <add key="CommitmentClientBillingTestEmail" value="n.nilkanth@infinity-data.com"/>
    <add key="ValuationClientBillingRunHour" value="7"/>
    <add key="ValuationClientBillingTestMode" value="false"/>
    <add key="ValuationClientBillingTestEmail" value="n.nilkanth@infinity-data.com"/>
    <add key="UnderwritingClientBillingRunHour" value="7"/>
    <add key="UnderwritingCreditClientBillingTestMode" value="false"/>
    <add key="UnderwritingCreditClientBillingTestEmail" value="n.nilkanth@infinity-data.com"/>
    <add key="UnderwritingServicingClientBillingTestMode" value="true"/>
    <add key="UnderwritingServicingClientBillingTestEmail" value="n.nilkanth@infinity-data.com"/>
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly><assemblyIdentity name="DocumentFormat.OpenXml" publicKeyToken="8fb06cb64d019a17" culture="neutral"/><bindingRedirect oldVersion="0.0.0.0-3.3.0.0" newVersion="3.3.0.0"/></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="DocumentFormat.OpenXml.Framework" publicKeyToken="8fb06cb64d019a17" culture="neutral"/><bindingRedirect oldVersion="0.0.0.0-3.3.0.0" newVersion="3.3.0.0"/></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/><bindingRedirect oldVersion="0.0.0.0-4.0.6.0" newVersion="4.0.6.0"/></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/><bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0"/></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/><bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2"/></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/><bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0"/></dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
