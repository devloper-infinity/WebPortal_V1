<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"><Target Name="CheckHRReportRequestTimeout" BeforeTargets="CoreCompile"><PropertyGroup><HRReportSourceText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Admin\HRReport.aspx.cs'))</HRReportSourceText></PropertyGroup><Error Condition="!$(HRReportSourceText.Contains('HttpContext.Current.Server.ScriptTimeout = 600;'))" Text="HR Report timeout protection is missing. Restore the 600-second ScriptTimeout in SkipLevelDetails before building/publishing; otherwise live exports can abort while SQL is running." /></Target></Project>